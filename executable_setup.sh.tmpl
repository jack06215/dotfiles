#!/usr/bin/env bash
set -euo pipefail -o posix
cd "$(dirname "$0")"

YARN_VERSION="4.12.0"
COREPACK_VERSION="0.33.0"

# Installed for every nodejs version in .tool-versions. Unpinned on purpose, so
# a rerun upgrades them the way `brew upgrade` does the Brewfile; pin one as
# `name@version` if it needs holding back. corepack is not listed because
# install_yarn_v4 installs it at COREPACK_VERSION.
NPM_GLOBAL_PACKAGES=(
  '@mermaid-js/mermaid-cli'
  'bash-language-server'
  'pyright'
  'typescript-language-server'
)

# gh extensions, installed if missing (`gh extension upgrade --all` updates).
GH_EXTENSIONS=(
  'dlvhdr/gh-dash'
)

# apt packages for Debian/Ubuntu (WSL2 included): what Homebrew cannot or
# should not provide.
APT_PACKAGES=(
  # Homebrew's own prerequisites
  build-essential procps curl file git
  # python-build, i.e. `asdf install python`
  libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev
  libncurses-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev
  liblzma-dev uuid-dev pkg-config
  # mason.nvim unpacks most language servers with it
  unzip
  # /usr/share/dict/words, which the nvim dictionary completion is built
  # from (run_onchange_after_generate-dictionary)
  wamerican
  # Claude Code's sandbox on Linux (macOS uses the built-in Seatbelt)
  bubblewrap socat
  # wl-copy/wl-paste: lazygit's and gh-dash's copy only know those, xclip and
  # xsel. WSLg keeps the Wayland clipboard in sync with the Windows one.
  wl-clipboard
  # gpg-agent.conf points pinentry at /usr/bin/pinentry-curses
  gnupg pinentry-curses
)

# Termux (Android) has neither Homebrew nor asdf: Homebrew does not support
# Android, and asdf's tools are prebuilt for glibc, which Android's bionic
# cannot run. pkgfiles/termux, the manifest generate-termux-packages.sh
# writes, stands in for both. Read from the checkout at run time, so an edit
# to it needs no `chezmoi apply` first.
TERMUX_MANIFEST={{ joinPath .chezmoi.sourceDir "pkgfiles/termux" | quote }}
TERMUX_CLAUDE_INSTALLER={{ joinPath .chezmoi.sourceDir "tools/setup/termux_install_claude_code.sh" | quote }}

# Go tools Termux has no package for, built into ~/.local/bin when missing.
# Delete the binary to rebuild: a build takes minutes on a phone.
TERMUX_GO_TOOLS=(
  # the time tracker behind tk/tockpick and the tmux status segment
  'github.com/kriuchkov/tock/cmd/tock@latest'
)

# The terminal font, fetched into ~/.termux/font.ttf when there is none.
PLEMOLJP_VERSION='v3.1.0'

# sshd lets in the machines whose public keys GitHub publishes for this
# account.
GITHUB_KEYS_USER='jack06215'

# apt-get rather than pkg, for a CLI that is stable in scripts. confold keeps a
# config under $PREFIX/etc that has been edited; confdef takes the new one
# where it has not.
TERMUX_APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

# Steps that failed but did not stop the run; reported at the end.
FAILURES=()

function note_failure() {
  FAILURES+=("$1")
  echo "warning: $1 failed; continuing" >&2
}

function read_tool_versions() {
  sed -E 's/ *#.*$//' .tool-versions \
    | # Remove comments
    grep -E '[^[:space:]]' # Remove blank lines
}

function foreach_tool_version() {
  local plugin_name="$1"
  local command="$2"

  local versions_line
  versions_line="$(read_tool_versions | grep -E "^${plugin_name}[[:space:]]+" | head -n 1 || true)"
  [[ -z "${versions_line}" ]] && return 0
  versions_line="$(sed -E "s/^${plugin_name}[[:space:]]+//" <<< "${versions_line}")"

  local -a versions_arr=()
  read -r -a versions_arr <<< "${versions_line}"

  local v
  for v in "${versions_arr[@]}"; do
    (
      asdf plugin add "${plugin_name}" 2> /dev/null || true
      asdf install "${plugin_name}" "${v}"
      export "ASDF_$(tr '[:lower:]' '[:upper:]' <<< "${plugin_name}")_VERSION=${v}"
      bash -euo pipefail -c "${command}"
    )
  done
}

function install_xcode_clt() {
  if xcode-select -p &> /dev/null; then
    return 0
  fi

  echo 'Xcode Command Line Tools not found. Triggering installation (accept the GUI prompt to continue)...'
  xcode-select --install

  # On a genuinely fresh machine this runs before Homebrew, so gum will not
  # exist yet and the plain loop is what actually executes. The spinner is for
  # reruns, where the wait is otherwise indistinguishable from a hang.
  if command -v gum &> /dev/null; then
    gum spin --spinner=moon \
      --title='Waiting for Xcode Command Line Tools (accept the GUI prompt)...' -- \
      bash -c 'until xcode-select -p &> /dev/null; do sleep 5; done'
  else
    until xcode-select -p &> /dev/null; do
      sleep 5
    done
  fi
}

function install_apt_packages() {
  local -a packages=("${APT_PACKAGES[@]}")

  # asdf's mysql plugin runs MySQL's generic Linux build, which links against
  # libaio.so.1. Debian 13 / Ubuntu 24.04 renamed the package for the 64-bit
  # time_t transition, and nothing provides the old soname any more.
  if apt-cache show libaio1t64 &> /dev/null; then
    packages+=(libaio1t64)
  else
    packages+=(libaio1)
  fi

  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"

  local libdir
  libdir="/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
  if [[ -e "${libdir}/libaio.so.1t64" && ! -e "${libdir}/libaio.so.1" ]]; then
    sudo ln -s libaio.so.1t64 "${libdir}/libaio.so.1"
  fi
}

# Put an installed-but-not-on-PATH Homebrew on PATH (e.g. setup.sh run from
# bash, which never read ~/.zshenv).
function load_homebrew() {
  local candidate
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "${candidate}" ]]; then
      eval "$("${candidate}" shellenv)"
      return 0
    fi
  done
  return 1
}

function install_homebrew() {
  if command -v brew &> /dev/null || load_homebrew; then
    return 0
  fi
  sudo echo
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  load_homebrew
}

function upgrade_homebrew_packages() {
  # ~/Brewfile is rendered from Brewfile.tmpl, which picks the manifest under
  # brewfiles/ matching this OS: taps + formulae + casks on macOS, taps +
  # formulae on Linux. It also carries the Homebrew 6.0 tap-trust state, and
  # `brew bundle install` applies that trust before it loads any entry and
  # installs taps ahead of what lives in them — which is why there is no longer
  # a separate tap/trust pass. Regenerate a manifest with generate-brewfile.sh;
  # see docs/homebrew-export-packages.md.
  #
  # Reported rather than fatal. Bundle hands every formula and cask to a single
  # `brew install`, so one entry brew refuses (a name installed from another
  # tap, a cask that no longer exists) fails all the others batched with it.
  # Stopping there would also skip everything below that does not depend on
  # the Brewfile; `brew upgrade` still brings what is installed up to date.
  brew bundle install --file="${HOME}/Brewfile" \
    || note_failure "brew bundle install (fix the entries it names in brewfiles/, then 'chezmoi apply')"

  brew upgrade || note_failure 'brew upgrade'
  brew cleanup || note_failure 'brew cleanup'
}

# asdf comes from the Brewfile (asdf >= 0.16, one binary, nothing to source).
# Its data - plugins, installs, shims - lives in ~/.asdf. Every tool in
# ~/.tool-versions is installed, one plugin at a time so a single failing
# build is reported without stopping the others.
function install_asdf_tools() {
  export ASDF_DATA_DIR="${ASDF_DATA_DIR:-${HOME}/.asdf}"
  export PATH="${ASDF_DATA_DIR}/shims:${PATH}"

  if ! command -v asdf &> /dev/null; then
    note_failure 'asdf (not installed; it comes from the Brewfile)'
    return 0
  fi

  # A plain word list, not a `while read` loop: asdf's installers read
  # stdin, and a fresh Mac runs this under bash 3.2, which has no process
  # substitution in POSIX mode.
  local plugin
  local -a plugins=()
  read -r -a plugins <<< "$(read_tool_versions | awk '{ print $1 }' | tr '\n' ' ')"
  for plugin in "${plugins[@]}"; do
    if ! asdf plugin list 2> /dev/null | grep -qx "${plugin}"; then
      asdf plugin add "${plugin}" || {
        note_failure "asdf plugin add ${plugin}"
        continue
      }
    fi
    asdf install "${plugin}" || note_failure "asdf install ${plugin}"
  done
}

function install_yarn_v4() {
  local cmd="
    if yarn --version 2>/dev/null | grep -qF '${YARN_VERSION}'; then
      echo 'Yarn ${YARN_VERSION} is already active; skipping.'
    else
      if ! corepack --version 2>/dev/null | grep -qF '${COREPACK_VERSION}'; then
        npm install -g 'npm:corepack@${COREPACK_VERSION}'
        asdf reshim nodejs
      fi
      corepack enable
      corepack prepare yarn@${YARN_VERSION} --activate
      asdf reshim nodejs
    fi
  "
  foreach_tool_version 'nodejs' "${cmd}"
}

function install_npm_global_packages() {
  # The command runs in a fresh `bash -c`, so the array has to be flattened
  # into it; %q keeps a spec like `foo@>=1.2` from being read as a redirect.
  local cmd
  cmd="
    npm install -g $(printf '%q ' "${NPM_GLOBAL_PACKAGES[@]}")
    asdf reshim nodejs
  "
  foreach_tool_version 'nodejs' "${cmd}"
}

function install_gh_extensions() {
  local installed ext
  installed="$(gh extension list 2> /dev/null || true)"
  for ext in "${GH_EXTENSIONS[@]}"; do
    if grep -qF "${ext}" <<< "${installed}"; then
      echo "gh extension ${ext} is already installed; skipping."
    else
      gh extension install "${ext}" || note_failure "gh extension install ${ext} (try after 'gh auth login')"
    fi
  done
}

# tpm itself is a chezmoi external (.chezmoiexternal.toml); this clones the
# plugins tmux.conf lists. tpm's CLI needs no running tmux: it starts a server
# only long enough to read TMUX_PLUGIN_MANAGER_PATH from tmux.conf.
function install_tmux_plugins() {
  local tpm="${HOME}/.local/share/tmux/plugins/tpm"
  if [[ ! -x "${tpm}/bin/install_plugins" ]]; then
    note_failure "tmux plugins (${tpm} missing; run 'chezmoi apply' first)"
    return 0
  fi
  "${tpm}/bin/install_plugins" || note_failure 'tmux plugin install'
}

# run_onchange_ scripts that found a tool missing on the first apply (yazi
# packages, the pinned shfmt, the dictionary) render differently once it is
# installed, so a second apply is what runs them.
function reapply_dotfiles() {
  chezmoi apply || note_failure 'chezmoi apply'
}

function read_manifest() {
  sed -E 's/[[:space:]]*#.*$//' "$1" | grep -E '[^[:space:]]'
}

function upgrade_termux_packages() {
  apt-get update
  apt-get full-upgrade "${TERMUX_APT_OPTS[@]}"
}

# Those of the given packages that are not installed.
function missing_packages() {
  local installed pkg
  installed=" $(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' "$@" 2> /dev/null \
    | awk '$1 == "ii" { print $2 }' | tr '\n' ' ' || true) "
  for pkg in "$@"; do
    [[ "${installed}" == *" ${pkg} "* ]] || echo "${pkg}"
  done
}

# One transaction. apt refuses the whole batch over a single name it cannot
# find, so a failed batch is retried a package at a time, to name the culprit
# and still install the rest.
function apt_install() {
  (($#)) || return 0
  apt-get install "${TERMUX_APT_OPTS[@]}" "$@" && return 0

  local pkg
  for pkg in "$@"; do
    apt-get install "${TERMUX_APT_OPTS[@]}" "${pkg}" || note_failure "apt-get install ${pkg}"
  done
}

function install_termux_packages() {
  if [[ ! -f "${TERMUX_MANIFEST}" ]]; then
    note_failure "Termux packages (${TERMUX_MANIFEST} not found)"
    return 0
  fi

  local -a repos=() packages=() missing=()
  read -r -a repos <<< "$(read_manifest "${TERMUX_MANIFEST}" | grep -- '-repo$' | tr '\n' ' ')"
  read -r -a packages <<< "$(read_manifest "${TERMUX_MANIFEST}" | grep -v -- '-repo$' | tr '\n' ' ')"

  # The *-repo entries first: each adds an apt source (x11, tur, glibc, root),
  # and apt cannot find the packages that live there until it is installed
  # and the index refreshed.
  read -r -a missing <<< "$(missing_packages "${repos[@]}" | tr '\n' ' ')"
  if ((${#missing[@]})); then
    apt_install "${missing[@]}"
    apt-get update || note_failure 'apt-get update'
  fi

  read -r -a missing <<< "$(missing_packages "${packages[@]}" | tr '\n' ' ')"
  if ((${#missing[@]})); then
    apt_install "${missing[@]}"
  else
    echo "All ${#packages[@]} packages are installed."
  fi
}

function install_go_tools() {
  if ! command -v go &> /dev/null; then
    note_failure 'Go tools (go not found; golang comes from pkgfiles/termux)'
    return 0
  fi

  local spec name
  for spec in "${TERMUX_GO_TOOLS[@]}"; do
    name="$(basename "${spec%@*}")"
    if [[ -x "${HOME}/.local/bin/${name}" ]]; then
      echo "${name} is already installed; skipping."
    else
      GOBIN="${HOME}/.local/bin" go install "${spec}" || note_failure "go install ${spec}"
    fi
  done
}

# Through the corepack that nodejs-lts bundles, not one from npm at
# COREPACK_VERSION as install_yarn_v4 does: npm's global bin comes after
# $PREFIX/bin on PATH, so an npm corepack would never be the one that runs -
# and from a shell that has not read ~/.zshenv, npm's prefix is $PREFIX itself
# and it would overwrite the package's files. The shims go to ~/.local/bin,
# not corepack's own directory, leaving $PREFIX to apt.
function install_termux_yarn_v4() {
  local bin="${HOME}/.local/bin"
  if "${bin}/yarn" --version 2> /dev/null | grep -qF "${YARN_VERSION}"; then
    echo "Yarn ${YARN_VERSION} is already active; skipping."
    return 0
  fi

  if ! command -v corepack &> /dev/null; then
    note_failure 'Yarn (corepack not found; it comes with nodejs-lts)'
    return 0
  fi

  mkdir -p "${bin}"
  if ! corepack enable --install-directory "${bin}" \
    || ! corepack prepare "yarn@${YARN_VERSION}" --activate; then
    note_failure "Yarn ${YARN_VERSION}"
  fi
}

# The same globals as on the other machines, into Termux's nodejs rather than
# asdf's. Not mermaid-cli: puppeteer downloads a Chrome build for it, and
# there is none for Android.
function install_termux_npm_packages() {
  local -a packages=()
  local pkg
  for pkg in "${NPM_GLOBAL_PACKAGES[@]}"; do
    [[ "${pkg}" == '@mermaid-js/mermaid-cli' ]] || packages+=("${pkg}")
  done
  npm install -g "${packages[@]}" || note_failure 'npm install -g'
}

# Termux's chsh only repoints ~/.termux/shell, which the next session reads.
function set_termux_shell() {
  if [[ "$(readlink "${HOME}/.termux/shell" 2> /dev/null)" == "${PREFIX}/bin/zsh" ]]; then
    echo 'zsh is already the login shell; skipping.'
    return 0
  fi
  chsh -s zsh || note_failure 'chsh -s zsh'
}

# Opens Android's storage permission prompt; ~/storage appears once it is
# granted.
function setup_termux_storage() {
  if [[ -d "${HOME}/storage" ]]; then
    echo "${HOME}/storage exists; skipping."
    return 0
  fi
  termux-setup-storage || note_failure 'termux-setup-storage'
}

# PlemolJP Console NF from its GitHub release, fetched rather than tracked
# since it is 5 MB of binary. A font already in place, whichever it is, is
# left alone.
function install_termux_font() {
  local font="${HOME}/.termux/font.ttf"
  if [[ -f "${font}" ]]; then
    echo "${font} exists; skipping."
    return 0
  fi

  local url zip
  url="https://github.com/yuru7/PlemolJP/releases/download/${PLEMOLJP_VERSION}/PlemolJP_NF_${PLEMOLJP_VERSION}.zip"
  zip="$(mktemp "${TMPDIR:-${PREFIX}/tmp}/plemoljp.XXXXXX")"
  mkdir -p "${HOME}/.termux"
  # The zip is 146 MB, the four NF families at every weight; only one file
  # comes out of it.
  if curl -fL --retry 2 -o "${zip}" "${url}" \
    && unzip -p "${zip}" '*/PlemolJPConsole_NF/PlemolJPConsoleNF-Regular.ttf' > "${font}.tmp" \
    && [[ -s "${font}.tmp" ]]; then
    mv "${font}.tmp" "${font}"
  else
    rm -f "${font}.tmp"
    note_failure "PlemolJP ${PLEMOLJP_VERSION} font"
  fi
  rm -f "${zip}"
}

# An authorized_keys already there is left alone.
function authorize_github_keys() {
  local keys="${HOME}/.ssh/authorized_keys"
  if [[ -s "${keys}" ]]; then
    echo "${keys} exists; skipping."
    return 0
  fi

  local fetched
  if fetched="$(curl -fsSL "https://github.com/${GITHUB_KEYS_USER}.keys")" && [[ -n "${fetched}" ]]; then
    mkdir -p "${HOME}/.ssh"
    chmod 700 "${HOME}/.ssh"
    (umask 077 && printf '%s\n' "${fetched}" > "${keys}")
  else
    note_failure "authorized_keys from github.com/${GITHUB_KEYS_USER}.keys"
  fi
}

# sshd listens on 8022. sv-enable needs the runsvdir that termux-services'
# profile.d script starts, along with exporting SVDIR, so the session that
# first installed termux-services has neither - and sv-enable's own SVDIR
# check tests -u where it means -z, so it never says so.
function enable_termux_services() {
  if [[ -z "${SVDIR:-}" ]]; then
    note_failure 'sshd/ssh-agent (termux-services not running yet; open a new Termux session and rerun)'
    return 0
  fi

  local service
  for service in sshd ssh-agent; do
    sv-enable "${service}" || note_failure "sv-enable ${service}"
  done
}

# Anthropic's linux-arm64 build, patched to run through glibc-runner, behind a
# launcher that keeps it updated; the installer is vendored from
# claude-code-android. Only when missing: it asks two questions and downloads
# ~233 MB, and updates are the launcher's job.
function install_termux_claude_code() {
  if [[ -x "${PREFIX}/bin/claude" ]]; then
    echo 'Claude Code is already installed; skipping.'
    return 0
  fi
  bash "${TERMUX_CLAUDE_INSTALLER}" || note_failure "Claude Code (${TERMUX_CLAUDE_INSTALLER})"
}

# Picks up ~/.termux/termux.properties as chezmoi just wrote it, and the font.
function reload_termux_settings() {
  termux-reload-settings || note_failure 'termux-reload-settings'
}

# gum when it is available, the hand-rolled ANSI path when it is not. The
# fallback is not optional here: this script is what installs gum, so the
# earliest sections necessarily run before it exists.
function section() {
  local msg="$1"

  if command -v gum &> /dev/null && [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    gum style --foreground=39 --bold --border=rounded --padding='0 2' --margin='1 0' "${msg}"
    return 0
  fi

  local color='' reset=''
  if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    color=$'\033[1;34m'
    reset=$'\033[0m'
  fi
  printf '\n%s==>%s %s\n' "${color}" "${reset}" "${msg}"
}

# Run a command under a spinner when gum is available, announcing it and
# running it plainly when it is not. Returns the command's own exit status
# either way, so callers can keep testing it directly.
#
# --show-error is what makes the spinner safe to wrap slow network commands in:
# silent while they succeed, full output the moment one fails.
#
# gum probes the terminal on startup and spin never reads the replies, so each
# step would leave one queued, to be typed at the prompt once the script ends.
# They are cleared after every step, the way _gum_spin does in
# dot_config/zsh/src/gum.zsh (zsh, so not sourceable here). With min 0 / time
# 1, cat takes what is queued and stops after a tenth of a second with nothing
# more. `|| rc=$?` rather than a bare call: under set -e a failing step would
# otherwise end the script before the clear.
function run_step() {
  local label="$1"
  shift

  if command -v gum &> /dev/null; then
    local rc=0 saved
    gum spin --spinner=dot --show-error --title="${label}" -- "$@" || rc=$?

    # The braces carry the 2>, so no controlling terminal (CI) stays quiet.
    if { saved=$(stty -g < /dev/tty); } 2> /dev/null; then
      stty -icanon -echo min 0 time 1 < /dev/tty
      cat < /dev/tty > /dev/null
      stty "${saved}" < /dev/tty
    fi
    return "${rc}"
  fi

  echo "${label}"
  "$@"
}

# The steps after Homebrew, shared by every OS.
function setup_common() {
  section 'Upgrading Homebrew packages'
  upgrade_homebrew_packages

  section 'Installing asdf tools'
  install_asdf_tools

  section 'Installing Yarn v4'
  install_yarn_v4

  section 'Installing npm global packages'
  install_npm_global_packages

  section 'Installing gh extensions'
  install_gh_extensions

  section 'Installing tmux plugins'
  install_tmux_plugins

  section 'Re-applying dotfiles'
  reapply_dotfiles
}

function setup_macos() {
  section 'Installing Xcode Command Line Tools'
  install_xcode_clt

  section 'Installing Homebrew'
  install_homebrew

  setup_common
}

function setup_linux() {
  section 'Installing apt packages'
  install_apt_packages

  section 'Installing Homebrew'
  install_homebrew

  setup_common
}

# Not setup_common: its Homebrew and asdf steps have no Termux counterpart, so
# the steps that carry over are called one by one.
function setup_termux() {
  section 'Upgrading Termux packages'
  upgrade_termux_packages

  section 'Installing Termux packages'
  install_termux_packages

  section 'Installing Go tools'
  install_go_tools

  section 'Installing Yarn v4'
  install_termux_yarn_v4

  section 'Installing npm global packages'
  install_termux_npm_packages

  section 'Installing gh extensions'
  install_gh_extensions

  section 'Installing tmux plugins'
  install_tmux_plugins

  section 'Setting up the Termux app'
  set_termux_shell
  setup_termux_storage
  install_termux_font

  section 'Enabling sshd and ssh-agent'
  authorize_github_keys
  enable_termux_services

  section 'Installing Claude Code'
  install_termux_claude_code

  section 'Re-applying dotfiles'
  reapply_dotfiles
  reload_termux_settings
}

{{/* osRelease is empty on macOS, and missingkey=error rejects reading it. */ -}}
{{ $isSupportedLinux := false -}}
{{ if eq .chezmoi.os "linux" -}}
{{- /* `get`: a rolling release has no VERSION_ID, and missingkey=error would
       fail the whole apply on it. */ -}}
{{   $id := get .chezmoi.osRelease "id" -}}
{{   $version := get .chezmoi.osRelease "versionID" -}}
{{   $isSupportedLinux = or (and (eq $id "debian") (has $version (list "12" "13"))) (and (eq $id "ubuntu") (has $version (list "22.04" "24.04" "26.04"))) -}}
{{ end -}}
{{ if .myComputer.isDarwin -}}
{{   if .myComputer.isArm -}}
setup_macos
{{   else -}}
echo 'Unsupported mac architecture. Only arm64 is supported.'
exit 1
{{   end -}}
{{ else if $isSupportedLinux -}}
setup_linux
{{ else if eq .chezmoi.os "android" -}}
setup_termux
{{ else -}}
echo 'Unsupported system. Supported: macOS (arm64), Debian 12/13, Ubuntu 22.04/24.04/26.04 (WSL2 included), Termux.'
exit 1
{{ end -}}

echo
if ((${#FAILURES[@]})); then
  echo 'Finished, but these steps failed:' >&2
  printf '  - %s\n' "${FAILURES[@]}" >&2
  exit 1
fi
echo 'Successfully completed! Open a new terminal session to apply the changes.'
