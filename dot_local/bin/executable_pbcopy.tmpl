{{ if eq .chezmoi.os "android" -}}
#!/data/data/com.termux/files/usr/bin/sh
# pbcopy for Termux: stdin -> the Android clipboard. Deployed only on WSL2 and
# Termux (see .chezmoiignore); macOS has the real one in /usr/bin. Gives tmux,
# lazygit and scripts the same command name they use on macOS.
#
# termux-clipboard-set comes from the termux-api package and only works with
# the Termux:API app installed next to it. It keeps the text byte for byte:
# no newline is added or stripped, and UTF-8 and CRLF come back unchanged.
#
# Android drops a copy somewhere between 1 and 1.5 MB without reporting it:
# termux-clipboard-set still exits 0 and the clipboard keeps its old text, so
# the next paste would be stale. Every termux-api call takes about half a
# second, so the text is read back only when it is large enough for that to
# happen, rather than doubling the time of every small copy.
tmp="$(mktemp)" || exit
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" || exit
termux-clipboard-set <"$tmp" || exit
size="$(wc -c <"$tmp")"
if [ "$size" -gt 524288 ] && ! termux-clipboard-get | cmp -s - "$tmp"; then
  echo "pbcopy: the clipboard did not take the $size bytes piped in;" \
    "Android drops copies over about 1 MB without an error" >&2
  exit 1
fi
{{ else -}}
#!/bin/sh
# pbcopy for WSL2: stdin -> the Windows clipboard. Deployed only on WSL2 and
# Termux (see .chezmoiignore); macOS has the real one in /usr/bin. An
# executable rather than a shell function, so tmux, lazygit, zellij, vim and
# scripts find it on PATH just like on macOS.
#
# win32yank talks to the clipboard API directly: UTF-8 in and out (clip.exe
# mangles non-ASCII) and it can paste too. --crlf gives Windows apps the line
# endings they expect; pbpaste's --lf undoes it, so a round trip inside WSL
# is lossless. The path comes from `chezmoi init` (.wsl.win32yank), because
# appendWindowsPath=false keeps Windows dirs off PATH.
y={{ .wsl.win32yank | squote }}
if [ -x "$y" ] || y="$(command -v win32yank.exe)"; then
  exec "$y" -i --crlf
fi

# No win32yank: clip.exe still copies, but reads the ANSI code page, so
# non-ASCII text comes out garbled.
echo "pbcopy: win32yank.exe not found, falling back to clip.exe" >&2
exec /mnt/c/Windows/System32/clip.exe
{{ end -}}
