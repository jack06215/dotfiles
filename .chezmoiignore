.config/yazi/plugins/**
.config/yazi/flavors/**

# navi writes its log next to the config file, and derives that path from its
# own default config dir rather than from $NAVI_CONFIG - so it lands here
# whatever the config says.
.config/navi/navi.log

**/*flywheel*
**/*flywheel*/**

# Bazel workspace files. `bazel run //:export_brewfile_<os>` is repo tooling;
# none of it belongs in $HOME. .bazelrc and .bazelversion need no entry here --
# chezmoi already skips source entries whose names start with a dot. Build
# symlinks are handled by --symlink_prefix=/ in .bazelrc, so there are no
# bazel-* roots to ignore either.
MODULE.bazel
MODULE.bazel.lock
BUILD.bazel

# Per-OS Brewfile manifests. Brewfile.tmpl `include`s the right one into
# ~/Brewfile, so the sources themselves must not also land in the target tree.
brewfiles
brewfiles/**

# Claude Code skills live at the repo root so they stay easy to edit and share.
# They reach ~/.config/claude/skills through the symlink_skills.tmpl link, so
# chezmoi must not also splat a copy of them into ~/skills.
skills
skills/**

# Windows-app configs. GlazeWM and Zebar only mean anything on Windows. On
# WSL2, run_onchange_after_push-windows-configs copies them - and WezTerm's,
# VS Code's and Firefox's - into the Windows home straight from the source, so
# the Linux home gets no copy. Windows Terminal's settings exist only to be
# pushed that way.
.config/windows-terminal
.config/windows-terminal/**
{{ if ne .chezmoi.os "windows" }}
.glzr
.glzr/**
# The PowerShell 7 profile, its MyModule and the choco/winget manifests. On
# Windows these are applied to ~/.config/powershell and then copied into
# Documents\PowerShell by run_onchange_after_link-powershell-profile.ps1, since
# that is the only path pwsh reads $PROFILE and PSModulePath from. On WSL2
# run_onchange_after_push-windows-configs sends them to the Windows home
# instead, so the Linux home gets no copy.
.config/powershell
.config/powershell/**
{{ end }}
{{ if .myComputer.isWSL2 }}
.config/wezterm
.config/wezterm/**
.config/vscode
.config/vscode/**
.config/firefox
.config/firefox/**
{{ end }}

{{ if eq .chezmoi.os "windows" }}
# The Homebrew half of provisioning. setup.sh renders to its "Unsupported
# system" branch on Windows and generate-brewfile.sh needs brew, so both were
# only ever dead weight in the Windows home; setup.ps1 and
# generate-chocofile.ps1 are what stand in for them.
Brewfile
setup.sh
generate-brewfile.sh
# `ya pkg install` rewrites every `hash` in package.toml from the deployed
# files, and those come out different on Windows than on macOS/WSL2 at identical
# `rev`s - so a managed copy makes every later apply stop on "has changed since
# chezmoi last wrote it", which would also block setup.ps1's final apply.
# run_onchange_after_install-yazi-packages.ps1 writes the pins instead, and ya
# owns the hashes from there.
.config/yazi/package.toml
{{ else }}
# The Windows half, conversely: Chocolatey, winget and mise exist nowhere else.
setup.ps1
generate-chocofile.ps1
{{ end }}

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "A0229") }}
.tool-versions
{{ end }}


# WSL2-only shims in ~/.local/bin (dot_local/bin): pbcopy/pbpaste wrap
# win32yank.exe - macOS has the real ones in /usr/bin, and these must never
# shadow them - and powershell.exe links the Windows binary onto PATH, which
# appendWindowsPath=false keeps off it, for tools that probe for it by name
# (nvim's img-clip pastes images through it).
{{ if not .myComputer.isWSL2 }}
.local/bin/pbcopy
.local/bin/pbpaste
.local/bin/powershell.exe
{{ end }}

