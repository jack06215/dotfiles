load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Repo tooling only: .chezmoiignore keeps tools/ out of $HOME, so the scripts
# here carry no chezmoi executable_ prefix. generate-chocofile.ps1 lives here
# too but has no target - no rule in the workspace can wrap a .ps1; see its
# header. Neither do the Termux scripts, which only run on the phone.

# Regenerates the Brewfile manifest of the machine you run it on, from what it
# currently has installed:
#
#     bazel run //tools/setup:export_brewfile_macos    # brewfiles/darwin, on a Mac
#     bazel run //tools/setup:export_brewfile_linux    # brewfiles/wsl2, on Linux/WSL2
#
# The script writes into the source tree, which a build action is not allowed to
# do, so these are run-only targets. `bazel run` exports
# BUILD_WORKSPACE_DIRECTORY, which the script prefers over asking chezmoi for
# the source path.
#
# One target per OS, each only compatible with its own: a manifest can only be
# dumped from the machine it describes, so a Mac is never offered a button that
# would rewrite the Linux manifest from its own package list, or vice versa.
sh_binary(
    name = "export_brewfile_macos",
    srcs = ["generate-brewfile.sh"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "export_brewfile_linux",
    srcs = ["generate-brewfile.sh"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# Pulls the PowerToys settings back out of %LOCALAPPDATA%\Microsoft\PowerToys
# and into dot_config/powertoys, reformatted the way the tracked copies are:
#
#     bazel run //tools/setup:export_powertoys_settings              # on Windows
#     bazel run //tools/setup:export_powertoys_settings -- --dry-run # look first
#
# The inverse of run_onchange_after_link-powertoys-settings.ps1, and Windows-only
# for the same reason: PowerToys exists nowhere else. Run-only, like the
# Brewfile exporters - it writes into the source tree, which a build action may
# not do.
#
# py_binary rather than sh_binary because sh_binary is run through bash on
# Windows, and the bash on PATH there is WSL's; see MODULE.bazel.
py_binary(
    name = "export_powertoys_settings",
    srcs = ["export_powertoys_settings.py"],
    legacy_create_init = 0,
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)
