{{- /*
macOS system settings that live in $(defaults) domains, captured from the Mac
on 2026-10-24. Values a new macOS 27 account already has are left out; many are
in /System/Library/Templates/Data/Library/User Template and in the
PreferenceDefaults of the trackpad and mouse drivers. Not applied on a company
machine.
*/ -}}
{{- if and .myComputer.isDarwin (not .myComputer.isCompanyMachine) -}}
#!/bin/bash
set -euo pipefail

# --- Appearance / Language & Region -------------------------------------------

# Auto (light by day, dark at night)
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool true
# 24-hour time (en_AU defaults to 12-hour)
defaults write NSGlobalDomain AppleICUForce24HourTime -bool true
# Spring-loaded folders: drag onto a folder to open it, after half a second
defaults write NSGlobalDomain com.apple.springing.enabled -bool true
defaults write NSGlobalDomain com.apple.springing.delay -float 0.5
# Sound: don't flash the screen on an alert
defaults write NSGlobalDomain com.apple.sound.beep.flash -int 0
defaults write NSGlobalDomain NSPreferredWebServices '<dict><key>NSWebServicesProviderWebSearch</key><dict><key>NSDefaultDisplayName</key><string>Google</string><key>NSProviderIdentifier</key><string>com.google.www</string></dict></dict>'
defaults write NSGlobalDomain shouldShowRSVPDataDetectors -bool false

# --- Menu Bar / Control Centre ------------------------------------------------

defaults write com.apple.controlcenter 'NSStatusItem VisibleCC Battery' -bool true
defaults write com.apple.controlcenter 'NSStatusItem VisibleCC BentoBox-0' -bool true
defaults write com.apple.controlcenter 'NSStatusItem VisibleCC Clock' -bool true
defaults write com.apple.controlcenter 'NSStatusItem VisibleCC WiFi' -bool true
defaults write com.apple.controlcenter RemoteLiveActivitiesEnabled -bool true
defaults -currentHost write com.apple.controlcenter FocusModes -int 8
defaults -currentHost write com.apple.controlcenter ShowSuggestions -bool true
defaults -currentHost write com.apple.controlcenter Spotlight -int 8
defaults -currentHost write com.apple.controlcenter VoiceControl -int 8
defaults write com.apple.TextInputMenu visible -bool true

# Clock
defaults write com.apple.menuextra.clock IsAnalog -bool true
defaults write com.apple.menuextra.clock ShowDate -int 0
defaults write com.apple.menuextra.clock ShowDayOfWeek -bool true
defaults write com.apple.menuextra.clock ShowAMPM -bool true
defaults write com.apple.menuextra.clock ShowSeconds -bool false

# --- Siri / Spotlight ---------------------------------------------------------

defaults write com.apple.Siri StatusMenuVisible -bool false
defaults write com.apple.Siri VoiceTriggerUserEnabled -bool true
defaults write com.apple.Siri ConfirmSiriInvokedViaEitherCmdTwice -bool false

# Search result categories
defaults write com.apple.Spotlight EnabledPreferenceRules -array \
  com.apple.iBooksX com.apple.iCal com.anthropic.claudefordesktop \
  com.apple.AddressBook com.apple.mail com.apple.MobileSMS com.apple.Music \
  com.apple.mobilephone com.apple.Photos com.apple.podcasts com.apple.Safari \
  System.files System.folders System.iphoneApps
defaults write com.apple.Spotlight DisabledUTTypes -array
defaults write com.apple.Spotlight PasteboardHistoryEnabled -bool true
defaults write com.apple.Spotlight 'NSStatusItem VisibleCC Item-0' -bool true
defaults -currentHost write com.apple.Spotlight MenuItemHidden -bool true

# --- Desktop & Dock -----------------------------------------------------------

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock tilesize -float 45
defaults write com.apple.dock magnification -bool true
defaults write com.apple.dock largesize -float 128

# Stage Manager (off) and the desktop around it
defaults write com.apple.WindowManager GloballyEnabled -bool false
defaults write com.apple.WindowManager AppWindowGroupingBehavior -int 1
defaults write com.apple.WindowManager AutoHide -bool false
defaults write com.apple.WindowManager HideDesktop -bool true
defaults write com.apple.WindowManager StandardHideWidgets -bool false
defaults write com.apple.WindowManager StageManagerHideWidgets -bool false
# Windows tiled by dragging to a screen edge sit flush, with no gaps
defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false

# Shut Down / Log Out: don't reopen windows when logging back in
defaults write com.apple.loginwindow TALLogoutSavesState -bool false

# --- Screenshots (Cmd-Shift-5 toolbar) ----------------------------------------

defaults write com.apple.screencapture style -string display
defaults write com.apple.screencapture target-screenshot -string file
defaults write com.apple.screencapture target-screenrecording -string file
defaults write com.apple.screencapture video -bool false

# --- Finder -------------------------------------------------------------------

# List view for new windows
defaults write com.apple.finder FXPreferredViewStyle -string Nlsv
defaults write com.apple.finder FXArrangeGroupViewBy -string Name
defaults write com.apple.finder RecentsArrangeGroupViewBy -string 'Date Last Opened'
defaults write com.apple.finder ShowSidebar -bool true
defaults write com.apple.finder ShowPreviewPane -bool false
# Tags shown in the sidebar
defaults write com.apple.finder FavoriteTagNames -array '' Red Orange Yellow Green Blue Purple Grey

# --- Trackpad -----------------------------------------------------------------

# Natural scrolling off. Takes effect after logging out.
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false

# Look up & data detectors: Force Click with one finger, not a three-finger
# tap. The built-in trackpad already defaults to that; a Bluetooth Magic
# Trackpad and the per-machine global default to the tap.
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerTapGesture -int 0
defaults -currentHost write NSGlobalDomain com.apple.trackpad.threeFingerTapGesture -int 0

defaults -currentHost write NSGlobalDomain com.apple.trackpad.scrollBehavior -int 2

# --- Keyboard -----------------------------------------------------------------

# Holding a key repeats it instead of popping up the accent picker. Read at
# app launch, so already-running apps keep the old behaviour until restarted.
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
defaults write com.apple.HIToolbox AppleDictationAutoEnable -int 1

# Text Input
defaults write NSGlobalDomain KB_SpellingLanguage '<dict><key>KB_SpellingLanguageIsAutomatic</key><true/></dict>'
# Smart quotes style. The curly quotes are the values themselves, written as
# literals because macOS's bash 3.2 has no \u escapes.
defaults write NSGlobalDomain KB_DoubleQuoteOption -string '“abc”'
# shellcheck disable=SC1112
defaults write NSGlobalDomain KB_SingleQuoteOption -string '‘abc’'
# shellcheck disable=SC1112
defaults write NSGlobalDomain NSUserQuotesArray -array '“' '”' '‘' '’'

# Keyboard Shortcuts, by ID, where this Mac differs from a new account: 60/61
# select the previous/next input source (off for a new account), 65 (Finder
# search, Opt-Cmd-Space) is off, and so are 160 (Show Apps, no key either way)
# and 164 (a Control-key shortcut a new account has on). parameters are (ASCII
# code, virtual key code, modifier mask), which Keyboard Settings keeps even
# for a disabled shortcut.
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add \
  60 '<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>262144</integer></array><key>type</key><string>standard</string></dict></dict>' \
  61 '<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>786432</integer></array><key>type</key><string>standard</string></dict></dict>' \
  65 '<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1572864</integer></array><key>type</key><string>standard</string></dict></dict>' \
  160 '<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>65535</integer><integer>65535</integer><integer>0</integer></array><key>type</key><string>standard</string></dict></dict>' \
  164 '<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>65535</integer><integer>65535</integer><integer>0</integer></array><key>type</key><string>standard</string></dict></dict>'

# --- Input Sources ------------------------------------------------------------

# Zhuyin, Australian and Japanese Romaji, plus the system's non-keyboard
# sources (Character Viewer, accent picker, kana palette, dictation). The Text
# Input server only rereads this list at login, so log out once after the first
# apply on a new Mac.
defaults write com.apple.HIToolbox AppleEnabledInputSources -array \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.TCIM</string><key>Input Mode</key><string>com.apple.inputmethod.TCIM.Zhuyin</string><key>InputSourceKind</key><string>Input Mode</string></dict>' \
  '<dict><key>InputSourceKind</key><string>Keyboard Layout</string><key>KeyboardLayout ID</key><integer>15</integer><key>KeyboardLayout Name</key><string>Australian</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.TCIM</string><key>InputSourceKind</key><string>Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.Kotoeri.RomajiTyping</string><key>Input Mode</key><string>com.apple.inputmethod.Japanese</string><key>InputSourceKind</key><string>Input Mode</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.Kotoeri.RomajiTyping</string><key>InputSourceKind</key><string>Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.CharacterPaletteIM</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.PressAndHold</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.50onPaletteIM</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.ironwood</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>'

# --- Accessibility ------------------------------------------------------------

# com.apple.universalaccess is TCC-protected: writing it needs Full Disk Access
# for the terminal running chezmoi. Without that, every write below fails, and
# that should not stop the rest of the apply, so failures are collected and
# reported at the end instead.
universalaccess_failed=0
universalaccess() {
  defaults write com.apple.universalaccess "$@" 2> /dev/null || universalaccess_failed=1
}
# Zoom
universalaccess closeViewZoomFactor -float 1
universalaccess closeViewCustomHotkeyKey '<dict><key>AX_ZOOM_FREEZE_PANNING</key><dict><key>charCode</key><integer>65535</integer><key>keyCode</key><integer>65535</integer><key>modifiers</key><integer>0</integer></dict><key>AX_ZOOM_MONITOR_SELECTION</key><dict><key>charCode</key><integer>65535</integer><key>keyCode</key><integer>65535</integer><key>modifiers</key><integer>0</integer></dict><key>AX_ZOOM_TEMP_DETACH</key><dict><key>charCode</key><integer>65535</integer><key>keyCode</key><integer>65535</integer><key>modifiers</key><integer>1310720</integer></dict><key>AX_ZOOM_TEMP_TOGGLE</key><dict><key>charCode</key><integer>65535</integer><key>keyCode</key><integer>65535</integer><key>modifiers</key><integer>786432</integer></dict><key>AX_ZOOM_TOGGLE_FS_AND_PIP</key><dict><key>charCode</key><integer>102</integer><key>keyCode</key><integer>3</integer><key>modifiers</key><integer>1572864</integer></dict></dict>'
# Hover Text, Live Speech
universalaccess hoverColorEnabled -bool false
universalaccess liveSpeechEnabled -bool false
# Keyboard: Sticky Keys
universalaccess useStickyKeysShortcutKeys -bool false

# --- Apply --------------------------------------------------------------------

# Keyboard shortcuts are cached per session; this makes them reread without a
# logout.
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

# Dock (and WindowManager with it), Finder and the menu bar in ControlCenter
# only read their prefs at launch. launchd restarts all three.
for app in Dock Finder ControlCenter; do
  killall "$app" 2> /dev/null || true
done

if ((universalaccess_failed)); then
  echo "macos-defaults: could not write com.apple.universalaccess - give the terminal Full Disk Access, then rerun:" >&2
  echo "  chezmoi execute-template < \"\$(chezmoi source-path)/.chezmoiscripts/run_onchange_after_macos-defaults.sh.tmpl\" | bash" >&2
fi
echo "macos-defaults: applied; log out to pick up scroll direction, trackpad and input sources"
{{- end -}}
