{{- /*
  pipf and s3_fetch_blob used to have hand-written specs in this repo,
  deployed to ~/.config/carapace/specs. They are generated now, from the
  monorepo's packages/carapace/specs, and the generator won't overwrite a spec
  it didn't write - so the deployed copies go, once per machine, before
  run_onchange_after_carapace-specs writes their replacements. .chezmoiremove
  can't do this: it would delete the generated ones on every apply too.

  Only a copy without the generator's marker is removed. Not on Windows, where
  the generator doesn't run and there is no zsh for them to complete.
*/ -}}
{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

specs="${XDG_CONFIG_HOME:-$HOME/.config}/carapace/specs"
for name in pipf s3_fetch_blob; do
  spec="$specs/$name.yaml"
  if [[ -f $spec ]] && ! head -n 3 "$spec" | grep -q '^# Generated by packages\.'; then
    rm -- "$spec"
    echo "carapace: removed the hand-written $spec; a generated one replaces it"
  fi
done
{{ end -}}
