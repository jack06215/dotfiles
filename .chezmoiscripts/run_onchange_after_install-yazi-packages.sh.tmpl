{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# chezmoi reruns this whenever its rendered text changes, so these two lines
# make it rerun once `ya` gets installed (a fresh machine applies the dotfiles
# before setup.sh's brew bundle) and whenever the plugin list changes:
#   ya:           {{ lookPath "ya" | default "not installed" }}
#   package.toml: {{ include "dot_config/yazi/package.toml.tmpl" | sha256sum }}

if ! command -v ya > /dev/null 2>&1; then
  # Not an error: on a fresh machine this runs before setup.sh has installed
  # yazi (brewfiles/{{ if .myComputer.isDarwin }}darwin{{ else }}wsl2{{ end }}). The next `chezmoi apply` after that - setup.sh
  # does one at the end - installs the packages.
  echo "yazi: 'ya' not found, skipping plugin install until yazi is installed" >&2
  echo "      (brew install yazi && chezmoi apply)" >&2
  exit 0
fi

ya pkg install

config_dir="${YAZI_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/yazi}"
manifest="$config_dir/package.toml"

if [[ -r "$manifest" ]]; then
  missing=()
  while IFS= read -r dir; do
    [[ -d "$config_dir/$dir" ]] || missing+=("$dir")
  done < <(awk '
    /^\[\[plugin\.deps\]\]/ { kind = "plugins"; next }
    /^\[\[flavor\.deps\]\]/ { kind = "flavors"; next }
    kind != "" && /^[[:space:]]*use[[:space:]]*=/ {
      if (match($0, /:[^"]+/)) print kind "/" substr($0, RSTART + 1, RLENGTH - 1) ".yazi"
    }
  ' "$manifest")

  if ((${#missing[@]})); then
    echo "yazi: 'ya pkg install' exited 0 but these are still missing under $config_dir:" >&2
    printf '        %s\n' "${missing[@]}" >&2
    echo "      init.lua require()s them, so yazi will not start. Check the fetch" >&2
    echo "      output above, then retry: ya pkg install" >&2
    exit 1
  fi
fi
{{ end -}}
