# Targets that used to be managed and are now gone from the source tree;
# `chezmoi apply` deletes them. (Paths relative to the destination, like
# .chezmoiignore.)

# WezTerm's config stopped being a template: chezmoi_tmpl.lua gave way to
# runtime detection in wezterm.lua plus machine.lua.
.config/wezterm/chezmoi_tmpl.lua

# MyModule's two upstream registries (IANA ports, IEEE OUI) stopped being
# tracked - 5.2 MB of third-party data that goes stale, which the functions
# fetch themselves with -UpdateList. Without these entries the copies a machine
# already received would linger and keep being copied on into
# Documents\PowerShell, since run_onchange_after_link-powershell-profile only
# ever adds files.
#
# This removes them from ~/.config only. Documents\PowerShell is deliberately
# left alone: that is where -UpdateList writes, so nothing here should delete
# what it puts there.
.config/powershell/Modules/MyModule/Functions/Network/Resources/IANA_ServiceName_and_TransportProtocolPortNumber_Registry.xml
.config/powershell/Modules/MyModule/Functions/Network/Resources/IEEE_Standards_Registration_Authority.csv

# Poetry's global config was deployed under the wrong name, where Poetry never
# looked; it is .config/pypoetry now.
.config/pyproject

# pipf's carapace completion read its packages through this zshfn symlink; the
# spec is generated by the monorepo's packages/carapace now, whose Python
# completer lists them itself.
.local/bin/pipf_installed

# The ghpr picker's rows and preview moved to the monorepo, as pycli's
# ghpr_index; gh.zsh runs it through pycli_cmdline. Its carapace spec goes on
# its own: the generator deletes the specs it wrote for commands now gone.
.config/zsh/src/myscripts/ghpr-index

# The Brewfile, Chocolatey and PowerToys exporters moved to tools/setup/, which
# is repo-only. Run them through `bazel run //tools/setup:...` or from the
# checkout.
generate-brewfile.sh
generate-chocofile.ps1
export-powertoys-settings.py
