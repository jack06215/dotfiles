export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_PREFIX_HOME="$HOME/.local"
export XDG_DATA_HOME="$XDG_PREFIX_HOME/share"
export XDG_STATE_HOME="$XDG_PREFIX_HOME/state"
export XDG_BIN_HOME="$XDG_PREFIX_HOME/bin"

# This file runs for every zsh, scripts and `zsh -c` included, so nothing in
# it forks. -U keeps the re-prepends below from piling up in nested shells
# (and moves an entry to the front instead).
typeset -U path fpath
{{- if eq .chezmoi.os "linux" }}

# Linuxbrew, for non-interactive shells too: a `zsh -c` from WezTerm's
# gui-startup, tmux's run-shell or a script would otherwise not find brew's
# tmux, git or nvim. What `brew shellenv` prints, minus its fork - and minus
# its `export FPATH`, see below.
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
  export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
  export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
  export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
  export INFOPATH="$HOMEBREW_PREFIX/share/info${INFOPATH:+:$INFOPATH}"
  path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
{{- end }}
path=("$XDG_BIN_HOME" $path)

# An exported FPATH replaces a child zsh's built-in function path, and zsh's
# own functions dir is versioned (Cellar/zsh/5.9.2/...): after `brew upgrade
# zsh`, every shell spawned from an environment captured earlier (the tmux
# server, WezTerm, an editor) would lose compinit, add-zsh-hook and
# is-at-least. So never export it, drop dirs that no longer exist, and if
# that took zsh's own functions with it, fall back to brew's unversioned link.
typeset +x FPATH
fpath=(${^fpath}(N-/))
_zsh_own_functions=(${^fpath}/compinit(N))
if (( ! ${#_zsh_own_functions} )) && [[ -n "$HOMEBREW_PREFIX" ]]; then
  fpath+=("$HOMEBREW_PREFIX/share/zsh/functions"(N-/))
fi
unset _zsh_own_functions

# Ubuntu's /usr/bin/zsh runs its own compinit from /etc/zsh/zshrc unless told
# not to; completion.zsh runs the one this config wants.
skip_global_compinit=1

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# $TTY is zsh's own; $(tty) forked on every zsh and said "not a tty" in
# scripts.
[[ -n "$TTY" ]] && export GPG_TTY="$TTY"

export EDITOR=vim
export VISUAL=vim

# asdf >= 0.16's default, spelled out: plugins, installs and shims stay where
# the old bash asdf kept them. See dot_config/zsh/src/asdf.zsh.
export ASDF_DATA_DIR="$HOME/.asdf"
export BUN_INSTALL="$XDG_DATA_HOME/bun"
export CABAL_CONFIG="$XDG_CONFIG_HOME/cabal/config"
export GLAZEWM_CONFIG_PATH="$XDG_CONFIG_HOME/glazewm/config.yaml"
export CABAL_DIR="$XDG_CACHE_HOME/cabal"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export CARGO_REGISTRIES_CRATES_IO_PROTOCOL=git
export COLIMA_HOME="${XDG_CONFIG_HOME}/colima"
export CONDARC="$XDG_CONFIG_HOME/conda/condarc"
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
# FZF_DEFAULT_COMMAND / FZF_DEFAULT_OPTS are defined in fzf.zsh, which loads
# later and always wins - defining them here too just risks drift.
export GEM_HOME="$XDG_DATA_HOME/gem"
export GEM_SPEC_CACHE="$XDG_CACHE_HOME/gem"
export GHCUP_USE_XDG_DIRS=1
export GIT_CONFIG_GLOBAL="$HOME/.config/git/config"
# Only where the key exists: pointing ssh at a missing identity breaks every
# git-over-ssh remote on that machine.
[[ -f "$HOME/.ssh/id_git" ]] && export GIT_SSH_COMMAND="ssh -i $HOME/.ssh/id_git"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export GOPATH="$XDG_DATA_HOME/go"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export GTK_RC_FILES="$XDG_CONFIG_HOME/gtk-1.0/gtkrc"
export GTK_USE_PORTAL=1
export HOMEBREW_NO_AUTO_UPDATE=1
export JULIA_DEPOT_PATH="$XDG_DATA_HOME/julia:$JULIA_DEPOT_PATH"
export KDEHOME="$XDG_CONFIG_HOME/kde"
export LEIN_HOME="$XDG_DATA_HOME/lein"
export LYNX_CFG="$XDG_CONFIG_HOME/lynx/lynx.cfg"
export LYNX_LSS="$XDG_CONFIG_HOME/lynx/lynx.lss"
export MAMBA_ROOT_PREFIX="$XDG_DATA_HOME/micromamba"
export MPLAYER_HOME="$XDG_CONFIG_HOME/mplayer"
export NAVI_CONFIG="$XDG_CONFIG_HOME/navi/config.yaml"
export NODE_REPL_HISTORY="$XDG_DATA_HOME/node_repl_history"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NVM_DIR="$XDG_DATA_HOME/nvm"
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
export POETRY_HOME="$XDG_DATA_HOME/poetry"
export PTPYTHON_CONFIG_HOME="$XDG_CONFIG_HOME/ptpython"
export PYENV_ROOT="$XDG_DATA_HOME/pyenv"
export PYTHONSTARTUP="$XDG_CONFIG_HOME/python/pythonrc.py"
export RBENV_ROOT="$XDG_DATA_HOME/rbenv"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export SSB_HOME="$XDG_DATA_HOME/zoom"
export STACK_ROOT="$XDG_DATA_HOME/stack"
export SUDO_EDITOR=vim
# wget refuses to run at all (exit 1) when WGETRC names a missing file.
[[ -f "$XDG_CONFIG_HOME/wgetrc" ]] && export WGETRC="$XDG_CONFIG_HOME/wgetrc"
# export XMODIFIERS='@im=fcitx'
# export GTK_IM_MODULE='fcitx'
# export QT_IM_MODULE='fcitx'
# export SDL_IM_MODULE='fcitx'
{{- if .myComputer.isWSL2 }}

# WSL2: the Windows side, resolved once by `chezmoi init` (.chezmoi.toml.tmpl)
# instead of asking cmd.exe/pwsh.exe on every shell start.
export WIN_USER={{ .wsl.windowsUser | squote }}
export WIN_HOME={{ .wsl.windowsHome | squote }}
{{- end }}
