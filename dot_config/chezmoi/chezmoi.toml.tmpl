{{- $pypoetryDir :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin/jack06215/nacho" (joinPath .chezmoi.homeDir ".cache/pypoetry/virtualenvs")
          "darwin/A0229/jack.cho"  (joinPath .chezmoi.homeDir "Library/Caches/pypoetry/virtualenvs")
        )
      )
-}}

{{- $firefoxProfilesDir :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin"  (joinPath .chezmoi.homeDir "Library/Application Support/Firefox/Profiles")
          "linux"   (joinPath .chezmoi.homeDir ".mozilla/firefox")
          "windows" (joinPath .chezmoi.homeDir "AppData/Roaming/Mozilla/Firefox/Profiles")
        )
      )
-}}

{{- $firefoxProfileId :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "default" "vfop1w54.default"
        "table" (dict
          "windows" "au24w27m.MinimalistDark"
        )
      )
-}}

{{- $vscodeUserDir :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin"  (joinPath .chezmoi.homeDir "Library/Application Support/Code/User")
          "linux"   (joinPath .chezmoi.homeDir ".config/Code/User")
          "windows" (joinPath .chezmoi.homeDir "AppData/Roaming/Code/User")
        )
      )
-}}

{{- /* poetry venv names are per-machine hashes, so these key on the username too */ -}}
{{- $zshPythonDir :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin/jack06215/nacho" (joinPath $pypoetryDir "monorepo-e2o0ZM2H-py3.14")
          "darwin/A0229/jack.cho"  (joinPath $pypoetryDir "monorepo-kcQbGqAg-py3.14")
        )
      )
-}}

{{- $fwMonorepoPythonDir :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin/A0229/jack.cho" (joinPath $pypoetryDir "monorepo-XYqwb38J-py3.13")
        )
      )
-}}

sourceDir = {{ env "CHEZMOI_SOURCE_DIR" | default (joinPath .chezmoi.homeDir "workspace/jack06215/dotfiles") | quote }}

[data.git]
    name = "Jack Cho"
    email = "jack06215@gmail.com"
[data]
    shell = {{ output "sh" "-c" "echo $SHELL" | trim | quote }}
[data.myComputer]
    hostname = {{ .chezmoi.hostname | quote }}
    username = {{ .chezmoi.username | quote }}
    arch = {{ .chezmoi.arch | quote }}
    homeDir = {{ .chezmoi.homeDir | quote }}
    isCompanyMachine = {{ env "IS_COMPANY_MACHINE" | eq "true" | toString | trim }}
    isDarwin = {{ eq .chezmoi.os "darwin" | toString | trim }}
    isLinux = {{ eq .chezmoi.os "linux" | toString | trim }}
    isWSL2 = {{ output "bash" "-c" "[[ \"$(uname -s)\" == 'Linux' ]] && [[ -r /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null && echo true || echo false" | trim }}
    isWindows = {{ eq .chezmoi.os "windows" | toString | trim }}
    isArm = {{ eq .chezmoi.arch "arm64" | toString | trim }}
    isX86 = {{ eq .chezmoi.arch "amd64" | toString | trim }}
[data.pypoetry]  
    pypoetryDir = {{ $pypoetryDir | quote }}
    zshPythonDir = {{ $zshPythonDir | quote }}
    fwMonorepoPythonDir = {{ $fwMonorepoPythonDir | quote }}
[data.firefox]
    profile = {{ $firefoxProfileId | quote }}
    profileDirBase = {{ $firefoxProfilesDir | quote }}
    profileDir = {{ joinPath $firefoxProfilesDir $firefoxProfileId | quote }}
[data.vscode]
    userDir = {{ $vscodeUserDir | quote }}
[data.xdg]
    configHome = {{ env "XDG_CONFIG_HOME" | default (joinPath .chezmoi.homeDir ".config") | quote }}
    dataHome = {{ env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") | quote }}
    cacheHome = {{ env "XDG_CACHE_HOME" | default (joinPath .chezmoi.homeDir ".cache") | quote }}
[template]
    options = ["missingkey=error"]
{{ if eq .chezmoi.os "windows" }}
[interpreters.ps1]
    # chezmoi's built-in default for .ps1 is Windows PowerShell 5.1
    # (powershell.exe -NoLogo); point it at PowerShell 7 instead. -NoProfile
    # keeps run_ scripts independent of $PROFILE.
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{ end }}

[diff]
    # run_onchange_ scripts embed dotfile content via `include`, so any dotfile
    # edit changes the script's hash and chezmoi diff would otherwise dump the
    # entire script body as a "new file". Excluding scripts keeps diff output
    # to actual file changes only.
    exclude = ["scripts"]
