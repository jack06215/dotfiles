# Nushell-only pet config: identical to config.toml.tmpl except for
# SnippetFile.
#
# pet has no per-shell notion of snippets - every invocation reads SnippetFile
# out of one config - so `--config` at the point of use is the only way to
# split them. The `pet` wrapper in dot_config/nushell/function.nu points every
# nushell invocation here; zsh keeps config.toml + snippet.toml.
[GHEGist]
    Public = false
    access_token = ""
    auto_sync = false
    base_url = ""
    file_name = ""
    gist_id = ""
    upload_url = ""

[General]
    Backend = "gist"
    Cmd = []
    Color = false
    Column = 40
    Editor = "vim"
    Format = "[$description] $tags|$command"
    SelectCmd = "fzf --ansi --layout=reverse --border --height=90% --pointer=* --cycle --prompt=Snippets: --delimiter='|' --with-nth=1 --preview 'echo {2..}' --preview-window=right:60%:wrap"
    SnippetDirs = []
    SnippetFile = "{{ .chezmoi.homeDir }}/.config/pet/snippet.nu.toml"
    SortBy = ""

[Gist]
    Public = false
    access_token = ""
    auto_sync = false
    file_name = "pet-snippet.toml"
    gist_id = ""

[GitLab]
    ID = ""
    Url = ""
    Visibility = "private"
    access_token = ""
    auto_sync = false
    file_name = "pet-snippet.toml"
    skip_ssl = false
