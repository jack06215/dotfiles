{{/*
  Appearance values that the `wezterm_config` zsh function tunes at runtime.

  They live in a machine-local state file rather than in the chezmoi source, so
  nudging the opacity neither dirties the repo nor follows you to a machine with
  a different screen. The dict below is the fallback for when that file does not
  exist, which is every machine that has never run `wezterm_config` - keep it in
  step with the defaults in dot_config/zsh/src/wezterm.zsh.

  XDG_STATE_HOME is resolved the same way dot_zshenv sets it, rather than read
  from chezmoi data, so this renders correctly without a `chezmoi init` to pick
  up a new config key.

  Each key is pulled across with an explicit hasKey test rather than through
  `merge`. sprig's merge treats 0 as an empty value and refuses to let it
  override a default, which would silently turn a fully transparent
  "opacity 0" back into 50. Do not collapse these blocks back into a merge.
*/ -}}
{{- $stateHome := env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local/state") -}}
{{- $stateFile := joinPath $stateHome "wezterm/appearance.json" -}}
{{- $saved := dict -}}
{{- if stat $stateFile -}}
{{-   $saved = output "cat" $stateFile | fromJson -}}
{{- end -}}
{{- $windowBackgroundOpacity := 50 -}}
{{- if hasKey $saved "windowBackgroundOpacity" -}}
{{-   $windowBackgroundOpacity = $saved.windowBackgroundOpacity -}}
{{- end -}}
{{- $textBackgroundOpacity := 50 -}}
{{- if hasKey $saved "textBackgroundOpacity" -}}
{{-   $textBackgroundOpacity = $saved.textBackgroundOpacity -}}
{{- end -}}
{{- $macosWindowBackgroundBlur := 5 -}}
{{- if hasKey $saved "macosWindowBackgroundBlur" -}}
{{-   $macosWindowBackgroundBlur = $saved.macosWindowBackgroundBlur -}}
{{- end -}}
local M = {}

--- Trim leading/trailing whitespace from a chezmoi-rendered long string.
--- Use with [=[ ... ]=] to keep template directives out of bare Lua tokens.
---
--- Example:
---   local val = M.tmpl([=[
---   {{- if .myComputer.isDarwin -}}
---       /bin/zsh
---   {{- else -}}
---       pwsh
---   {{- end -}}
---   ]=])
---
---@param s string
---@return string
function M.tmpl(s)
	local result, _ = s:gsub("^%s*(.-)%s*$", "%1")
	return result
end

--- Check if a chezmoi boolean data key is true at apply time.
--- Key must match an entry in M._data.
---
--- Example:
---   if tmpl.is_true("myComputer.isDarwin") then
---     config.macos_window_background_blur = 40
---   end
---
M._data = {
	["myComputer.isDarwin"] = M.tmpl([=[{{- if index .myComputer "isDarwin" -}}true{{- end -}}]=]) == "true",
	["myComputer.isWindows"] = M.tmpl([=[{{- if index .myComputer "isWindows" -}}true{{- end -}}]=]) == "true",
	["myComputer.isLinux"] = M.tmpl([=[{{- if index .myComputer "isLinux" -}}true{{- end -}}]=]) == "true",
	["myComputer.isArm"] = M.tmpl([=[{{- if index .myComputer "isArm" -}}true{{- end -}}]=]) == "true",
	["myComputer.isX86"] = M.tmpl([=[{{- if index .myComputer "isX86" -}}true{{- end -}}]=]) == "true",
	["myComputer.isCompanyMachine"] = M.tmpl([=[{{- if index .myComputer "isCompanyMachine" -}}true{{- end -}}]=])
		== "true",
}

---@param key string   dot-separated chezmoi data path
---@return boolean
function M.is_true(key)
	return M._data[key] == true
end

--- Appearance numbers, as authored: a 0-100 percentage for the two opacities
--- and a point radius for the blur. Change them with `wezterm_config` (zsh)
--- rather than by editing this file, which chezmoi regenerates.
M._numbers = {
	windowBackgroundOpacity = tonumber(M.tmpl([=[{{ $windowBackgroundOpacity }}]=])),
	textBackgroundOpacity = tonumber(M.tmpl([=[{{ $textBackgroundOpacity }}]=])),
	macosWindowBackgroundBlur = tonumber(M.tmpl([=[{{ $macosWindowBackgroundBlur }}]=])),
}

--- Raw value for an appearance key, in the units it is authored in.
---
---@param key string
---@return number
function M.num(key)
	return M._numbers[key]
end

--- An appearance percentage as the 0.0-1.0 fraction WezTerm's opacity options
--- expect. Keeping the conversion here means the 0-100 scale that
--- `wezterm_config` presents is mapped in exactly one place.
---
---@param key string
---@return number
function M.pct(key)
	return M._numbers[key] / 100
end

--- Build a string list, appending each extra value only if it is non-empty.
--- Useful for constructing command arrays where some arguments are platform-
--- conditional and render to "" when not applicable.
---
--- Example:
---   local prog = M.compact(shell, flag, extra)
---   -- { "/bin/zsh", "--login" }  on darwin
---   -- { "pwsh" }                 on windows/linux (flag and extra were "")
---
---@param ... string   one or more strings; empty strings are omitted
---@return string[]
function M.compact(...)
	local args = table.pack(...)
	local result = {}
	for i = 1, args.n do
		if args[i] ~= "" then
			table.insert(result, args[i])
		end
	end
	return result
end

--- Resolve the primary modifier key for the current platform.
--- Returns "CMD" on macOS, "CTRL" everywhere else.
---
---@return string
function M.mod()
	return M.tmpl([=[
        {{- if .myComputer.isDarwin -}}
            CMD
        {{- else -}}
            CTRL
        {{- end -}}
      ]=])
end

return M
