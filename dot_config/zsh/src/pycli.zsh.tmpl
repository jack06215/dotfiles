{{- /*
  `pycli` runs `packages.cli`: bare, it lists every subcommand with its
  description; `pycli <subcommand> ...` runs one.

  It runs in the directory it's called from, not the monorepo, so a tool sees
  the caller's files and repo (`md2docx notes.md`, boolsearch's `.`, gh and
  git in ghpr_index and lcg_github_create_pull_request). PYTHONPATH finds
  packages.cli instead, and -P keeps a `packages/` in the working directory
  from shadowing it. The venv's bin goes first on PATH and VIRTUAL_ENV is set,
  as its activate script would, for what a tool runs in turn (llm_cat's llm).

  Plus one zsh function per subcommand, generated on `chezmoi apply` from
  `python -m packages.cli --list`, so adding a tool to `_COMMANDS` in the
  monorepo never needs an edit here - just re-apply. `--list` prints only the
  names: an entry's preset positional arguments (the rest of its `_COMMANDS`
  list after the module path) are put in by packages.cli itself, so a wrapper
  passes on just what was typed, and `<name> ...` runs exactly like
  `pycli <name> ...`. Machines without the monorepo or its venv get `pycli`
  and no wrappers.

  Tab completion for `pycli` and every wrapper comes from carapace specs that
  .chezmoiscripts/run_onchange_after_pycli-carapace-specs.sh.tmpl generates
  from the same tools on apply.
*/ -}}
{{- $repo := joinPath .chezmoi.homeDir "workspace/jack06215/monorepo" -}}
{{- $venv := .pypoetry.zshPythonDir -}}
{{- $python := joinPath $venv "bin/python" -}}
# Prints `pycli <args>` as one line of shell, for what can't call a zsh
# function: fzf runs its binds in a fresh shell, which has none of these.
# pycli itself runs this line, so the two can't differ.
function pycli_cmdline() {
  local repo="{{ $repo }}"
  local venv="{{ $venv }}"

  if [[ ! -d "$repo" ]]; then
    print -u2 "pycli: repo not found: $repo"
    return 1
  fi
  if [[ -z "$venv" || ! -x "$venv/bin/python" ]]; then
    print -u2 "pycli: venv python not found: ${venv:-(no venv)}/bin/python"
    print -u2 "pycli: run 'poetry install' or check .pypoetry.zshPythonDir in chezmoi"
    return 1
  fi

  print -r -- "PATH=${(q)venv}/bin:\"\$PATH\" VIRTUAL_ENV=${(q)venv}" \
    "PYTHONPATH=${(q)repo} ${(q)venv}/bin/python -P -m packages.cli ${(j: :)${(q)@}}"
}

function pycli() {
  local cmdline
  cmdline="$(pycli_cmdline "$@")" || return
  eval "$cmdline"
}
{{- if and $venv (stat (joinPath $repo "packages/cli.py")) (stat $python) }}
{{- /* Paths go in as positional args so sh never re-parses them. */}}
{{-   $names := output "sh" "-c" "cd \"$1\" && exec \"$2\" -m packages.cli --list" "sh" $repo $python }}
{{-   "\n" }}
{{- /* The names are pasted into shell source: skip anything that isn't a
       plain function name (test_cli.py asserts none are). */}}
{{-   range $names | trim | splitList "\n" }}
{{-     if regexMatch "^[a-z][a-z0-9_]*$" . }}
function {{ . }}() { pycli {{ . }} "$@"; }
{{-     end }}
{{-   end }}
{{- end }}
