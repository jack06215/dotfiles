{{- /*
  One zsh function per `packages.cli` subcommand, generated on `chezmoi apply`
  from `python -m packages.cli --list`, so adding a tool to `_COMMANDS` in the
  monorepo never needs an edit here - just re-apply. Machines without the
  monorepo or its venv get `_pycli` and no wrappers.
*/ -}}
{{- $repo := joinPath .chezmoi.homeDir "workspace/jack06215/monorepo" -}}
{{- $venv := .pypoetry.zshPythonDir -}}
{{- $python := joinPath $venv "bin/python" -}}
function _pycli() {
  local repo="{{ $repo }}"
  local venv="{{ $venv }}"

  if [[ ! -d "$repo" ]]; then
    print -u2 "_cli: repo not found: $repo"
    return 1
  fi
  if [[ ! -f "$venv/bin/activate" ]]; then
    print -u2 "_cli: venv activate script not found: $venv/bin/activate"
    print -u2 "_cli: run 'poetry install' or check .pypoetry.zshPythonDir in chezmoi"
    return 1
  fi

  (
    cd "$repo" \
      && source "$venv/bin/activate" \
      && python -m packages.cli "$@"
  )
}
{{- if and $venv (stat (joinPath $repo "packages/cli.py")) (stat $python) }}
{{- /* Paths go in as positional args so sh never re-parses them. */}}
{{-   $names := output "sh" "-c" "cd \"$1\" && exec \"$2\" -m packages.cli --list" "sh" $repo $python }}
{{-   "\n" }}
{{- /* The names are pasted into shell source: skip anything that isn't a
       plain function name (test_cli.py asserts none are). */}}
{{-   range $names | trim | splitList "\n" }}
{{-     if regexMatch "^[a-z][a-z0-9_]*$" . }}
function {{ . }}() { _pycli {{ . }} "$@"; }
{{-     end }}
{{-   end }}
{{- end }}
