" vim: set ft=vim :
" =============================================================================
" Minimal vim - the fast path next to nvim.
"
" nvim stays the IDE: vimfind, vimrecent and fzf-listprojects still call it
" directly. vim is what $EDITOR points at, so it handles the short-lived
" edits - `gcm` commit messages, rebase conflict resolution, sudoedit, and
" ls_fzf_open. Everything here has to be worth its cost on a 10-second edit.
"
" Lives at $XDG_CONFIG_HOME/vim/vimrc, which vim >= 9.1.0327 finds by itself
" (no ~/.vimrc needed). Picking this file up also puts $MYVIMDIR at the head
" of 'runtimepath' and $MYVIMDIR/after at the tail, so after/ftplugin/ loads
" with no rtp fiddling - and ~/.vim drops out of the path entirely.
" =============================================================================

set nocompatible

" --- State ------------------------------------------------------------------
" $HOME stays clean, same as everything else in dot_zshenv.tmpl. The trailing
" `//` on swap/backup makes vim encode the full path into the file name, so
" two files with the same basename can't collide.
let s:state = expand(empty($XDG_STATE_HOME) ? '~/.local/state/vim' : $XDG_STATE_HOME . '/vim')
for s:dir in ['undo', 'swap', 'backup']
  if !isdirectory(s:state . '/' . s:dir)
    call mkdir(s:state . '/' . s:dir, 'p', 0700)
  endif
endfor
let &undodir    = s:state . '/undo'
let &directory  = s:state . '/swap//'
let &backupdir  = s:state . '/backup//'
let &viminfofile = s:state . '/viminfo'
set undofile

" --- Behaviour --------------------------------------------------------------
set encoding=utf-8
scriptencoding utf-8
set hidden
set autoread
set confirm
set backspace=indent,eol,start
set nostartofline
set splitbelow splitright
set history=1000
set updatetime=300
set timeoutlen=500
" Without a short ttimeoutlen, leaving insert mode lags a full second - the
" same reason the shell runs `bindkey -v` with a fast KEYTIMEOUT.
set ttimeoutlen=10
" The `# vim: filetype=zsh` headers on myscripts/* and functions.zsh depend
" on this. It is on by default, but it is load-bearing here, so it is stated.
set modeline modelines=5

" --- Search -----------------------------------------------------------------
set ignorecase smartcase
set incsearch hlsearch
if executable('rg')
  let &grepprg = 'rg --vimgrep --smart-case --hidden --glob=!.git/'
  set grepformat=%f:%l:%c:%m
endif

" --- Filetypes for this repo ------------------------------------------------
" chezmoi source names are not something vim can type on its own. This block
" has to be registered BEFORE `filetype on`: autocmds fire in registration
" order, and vim's own rule types every *.tmpl as `template`, after which
" did_filetype() makes any re-detect a silent no-op.
augroup vimrc_chezmoi
  autocmd!
  " Re-run detection against the name minus `.tmpl`, so init.zsh.tmpl,
  " setup.sh.tmpl, wezterm.lua.tmpl and chezmoi.toml.tmpl land on the
  " filetype of what they actually generate.
  autocmd BufRead,BufNewFile *.tmpl
        \ execute 'silent! doautocmd filetypedetect BufRead'
        \         fnameescape(expand('<afile>:r'))
  " The leftovers, where stripping `.tmpl` still leaves a name vim can't
  " place - `dot_zshenv` and chezmoi's `dot_config/git/config`.
  autocmd BufRead,BufNewFile dot_zshenv*,dot_zshrc*,dot_zprofile*
        \ setfiletype zsh
  autocmd BufRead,BufNewFile */git/config,*/git/config.tmpl
        \ setfiletype gitconfig
augroup END

" --- UI ---------------------------------------------------------------------
syntax enable
filetype plugin indent on

" retrobox is vim's bundled gruvbox port, so this matches the nvim theme
" without pulling in a colorscheme plugin.
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
  let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
  let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  set termguicolors
endif
set background=dark
silent! colorscheme retrobox

set number relativenumber
set cursorline
set ruler showcmd
set laststatus=2
set scrolloff=4 sidescrolloff=8
set display+=lastline
set shortmess+=I
set belloff=all
set list listchars=tab:»·,trail:·,nbsp:␣,extends:›,precedes:‹
set wildmenu
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*/.git/*,*/node_modules/*,*/__pycache__/*,*.pyc

" --- Indentation ------------------------------------------------------------
" Mirrors .editorconfig: 2 spaces everywhere, 4 for python.
set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set shiftround
set autoindent
augroup vimrc_indent
  autocmd!
  autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4
  autocmd FileType make   setlocal noexpandtab
augroup END

" Reopen a file where it was left, except for commit messages - those want a
" fresh cursor at the top every time.
augroup vimrc_lastpos
  autocmd!
  autocmd BufReadPost *
        \ if &filetype !~# '^\(git\|gitcommit\|gitrebase\)$'
        \    && line("'\"") >= 1 && line("'\"") <= line("$") |
        \   execute "normal! g`\"" |
        \ endif
augroup END

" --- Keymaps ----------------------------------------------------------------
let mapleader = ' '
let maplocalleader = ' '
nnoremap <Space> <Nop>

" <C-l> already redraws; clearing the search highlight on the way is free.
nnoremap <silent> <C-l> :nohlsearch<CR><C-l>

nnoremap <leader>w :write<CR>
nnoremap Y y$
nnoremap n nzzzv
nnoremap N Nzzzv
xnoremap < <gv
xnoremap > >gv
" Explicit clipboard yanks - 'clipboard=unnamed' would mean every delete in a
" commit message clobbers whatever was in the pasteboard.
nnoremap <leader>y "+y
xnoremap <leader>y "+y
nnoremap <leader>Y "+y$

" Conflict markers. This vim has no built-in `]n` motion (that one is a
" neovim/unimpaired thing), and `git rebase` conflict edits are a main reason
" this config exists, so the motion is defined here.
nnoremap <silent> ]x /^\(<\{7\}\\|=\{7\}\\|>\{7\}\)/<CR>
nnoremap <silent> [x ?^\(<\{7\}\\|=\{7\}\\|>\{7\}\)?<CR>

" Mouse stays off so terminal select-and-copy keeps working. Uncomment for
" scroll and click-to-position:
" set mouse=a

" --- fzf --------------------------------------------------------------------
" Reuses the plugin file that ships inside the fzf package - no plugin
" manager, nothing to keep updated. It provides fzf#run/fzf#wrap and :FZF;
" :Files/:Rg below are the small wrappers, matching the fd/rg/bat pipeline
" the shell functions already use.
for s:fzf in ['/opt/homebrew/opt/fzf/plugin/fzf.vim',
      \       '/home/linuxbrew/.linuxbrew/opt/fzf/plugin/fzf.vim',
      \       '/usr/share/doc/fzf/examples/fzf.vim',
      \       '/data/data/com.termux/files/usr/share/fzf/fzf.vim',
      \       expand('~/.fzf/plugin/fzf.vim')]
  if filereadable(s:fzf)
    execute 'source' fnameescape(s:fzf)
    break
  endif
endfor

if exists('*fzf#run')
  let s:preview = 'bat --style=numbers --color=always --line-range :300 -- {}'

  " $FZF_DEFAULT_OPTS carries a preview that assumes {} is a bare path, so
  " every command below passes its own --preview to win on the command line.
  command! -bang -nargs=? -complete=dir Files
        \ call fzf#run(fzf#wrap('files', {
        \   'source': 'fd --type f --hidden --follow --exclude .git' .
        \             (empty(<q-args>) ? '' : ' . ' . shellescape(<q-args>)),
        \   'options': ['--multi', '--prompt', 'files> ', '--preview', s:preview],
        \ }, <bang>0))

  command! -bang Buffers
        \ call fzf#run(fzf#wrap('buffers', {
        \   'source': map(filter(range(1, bufnr('$')),
        \                 'buflisted(v:val)'), 'bufname(v:val)'),
        \   'options': ['--prompt', 'buffers> ', '--preview', s:preview],
        \ }, <bang>0))

  " Custom sink, so fzf#wrap's file-opening sink is deliberately not used -
  " results are file:line:col and need parsing before the jump.
  function! s:rg_sink(line) abort
    let l:parts = matchlist(a:line, '\v^([^:]+):(\d+):(\d+):')
    if empty(l:parts)
      return
    endif
    execute 'edit' fnameescape(l:parts[1])
    call cursor(str2nr(l:parts[2]), str2nr(l:parts[3]))
    normal! zz
  endfunction

  command! -nargs=+ Rg
        \ call fzf#run({
        \   'source': 'rg --column --line-number --no-heading --color=never'
        \             . ' --smart-case --hidden --glob=!.git/ -- '
        \             . shellescape(<q-args>),
        \   'sink': function('s:rg_sink'),
        \   'options': ['--prompt', 'rg> ', '--delimiter', ':',
        \               '--preview', 'bat --style=numbers --color=always'
        \               . ' --highlight-line {2} --line-range :300 -- {1}',
        \               '--preview-window', '+{2}-/2'],
        \ })

  nnoremap <leader>f :Files<CR>
  nnoremap <leader>b :Buffers<CR>
  nnoremap <leader>g :Rg<Space>
endif
