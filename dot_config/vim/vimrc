" vim: set ft=vim :
" =============================================================================
" vim - a capable second editor, managed with vim-plug.
"
" nvim is still the IDE. This is what $EDITOR points at, so it has to open fast
" for a `gcm` commit message, and it has to be good enough to actually work in
" when nvim is overkill or unavailable.
"
" Lives at $XDG_CONFIG_HOME/vim/vimrc, which vim >= 9.1.0327 finds by itself.
" Picking it up also puts $MYVIMDIR at the head of 'runtimepath' and
" $MYVIMDIR/after at the tail - which is how autoload/plug.vim and
" after/ftplugin/ are found with no rtp fiddling.
"
" Layout of this file is load-bearing; see the two ORDER notes below.
" =============================================================================

set nocompatible

" ORDER: the leader must be set before plug#end() loads plugins, or any
" <leader> mapping a plugin defines binds to the wrong key.
let mapleader = ' '
let maplocalleader = ' '

" --- State ------------------------------------------------------------------
" $HOME stays clean, same as everything else in dot_zshenv.tmpl. The trailing
" `//` on swap/backup makes vim encode the full path into the file name, so
" two files with the same basename can't collide.
let s:state = expand(empty($XDG_STATE_HOME) ? '~/.local/state/vim' : $XDG_STATE_HOME . '/vim')
let s:data  = expand(empty($XDG_DATA_HOME)  ? '~/.local/share'     : $XDG_DATA_HOME)
for s:dir in ['undo', 'swap', 'backup', 'spell']
  if !isdirectory(s:state . '/' . s:dir)
    call mkdir(s:state . '/' . s:dir, 'p', 0700)
  endif
endfor
let &undodir     = s:state . '/undo'
let &directory   = s:state . '/swap//'
let &backupdir   = s:state . '/backup//'
let &viminfofile = s:state . '/viminfo'
" `zg` fails with E764 unless 'spellfile' has a value. Vim only fills it in
" automatically when a `spell` directory already exists inside 'runtimepath',
" which it doesn't here, so it is pointed at the state dir explicitly.
let &spellfile   = s:state . '/spell/en.utf-8.add'
set undofile

" --- Filetypes for this repo ------------------------------------------------
" ORDER: this block must be registered BEFORE plug#end(), which calls
" `filetype plugin indent on`. Autocmds fire in registration order, and vim's
" own rule types every *.tmpl as `template`, after which did_filetype() makes
" any re-detect a silent no-op. Move this below plug#end() and chezmoi
" template detection breaks with no error.
augroup vimrc_chezmoi
  autocmd!
  " Re-run detection against the name minus `.tmpl`, so init.zsh.tmpl,
  " setup.sh.tmpl, wezterm.lua.tmpl and chezmoi.toml.tmpl land on the
  " filetype of what they actually generate.
  autocmd BufRead,BufNewFile *.tmpl
        \ execute 'silent! doautocmd filetypedetect BufRead'
        \         fnameescape(expand('<afile>:r'))
  " The leftovers, where stripping `.tmpl` still leaves a name vim can't
  " place - `dot_zshenv` and chezmoi's `dot_config/git/config`.
  autocmd BufRead,BufNewFile dot_zshenv*,dot_zshrc*,dot_zprofile*
        \ setfiletype zsh
  autocmd BufRead,BufNewFile */git/config,*/git/config.tmpl
        \ setfiletype gitconfig
augroup END

" --- Plugin settings read at load time --------------------------------------
" These have to precede plug#end(); the plugins read them as they load.

" vim-matchup - mirrors the nvim config.
let g:matchup_matchparen_offscreen = {'method': 'popup'}
let g:matchup_matchparen_deferred = 1
let g:matchup_matchparen_timeout = 300
let g:matchup_surround_enabled = 1

" vim-sneak. Label mode is deliberately OFF: with it on, s{char}{char} stops
" and waits for a label keypress whenever more than one match is visible,
" which reads as "s does nothing". Without it, s{char}{char} jumps straight to
" the nearest match and ; / , walk the rest.
let g:sneak#label = 0
" Follow 'ignorecase'/'smartcase', so szq matches ZQ the way / does.
let g:sneak#use_ic_scs = 1

" goyo - same dimensions as the nvim setup.
let g:goyo_width = 100
let g:goyo_height = '80%'

" fzf.vim - :Files honours $FZF_DEFAULT_COMMAND, which fzf.zsh exports for
" interactive shells. It is set here too so sudoedit and other non-shell
" launches get the same fd-based listing instead of fzf's slow builtin walk.
if empty($FZF_DEFAULT_COMMAND)
  let $FZF_DEFAULT_COMMAND = 'fd --type f --hidden --follow --exclude .git'
endif
let g:fzf_action = {
      \ 'ctrl-t': 'tab split',
      \ 'ctrl-x': 'split',
      \ 'ctrl-v': 'vsplit' }
let g:fzf_preview_window = ['right:55%', 'ctrl-/']

" vim-lsp - quiet by default; the noisy bits get in the way more than they
" help in a second editor.
let g:lsp_diagnostics_enabled = 1
let g:lsp_diagnostics_echo_cursor = 1
let g:lsp_diagnostics_virtual_text_enabled = 0
let g:lsp_diagnostics_signs_error   = {'text': 'E'}
let g:lsp_diagnostics_signs_warning = {'text': 'W'}
let g:lsp_document_code_action_signs_enabled = 0
let g:lsp_fold_enabled = 0
let g:lsp_log_file = ''
" Servers installed by vim-lsp-settings land here rather than in $HOME.
let g:lsp_settings_servers_dir = s:data . '/vim-lsp-settings/servers'

" asyncomplete
let g:asyncomplete_auto_popup = 1
let g:asyncomplete_popup_delay = 100

" --- Plugins ----------------------------------------------------------------
" plug.vim is vendored at $MYVIMDIR/autoload/plug.vim and tracked in the
" dotfiles repo, so a fresh machine needs no network and no bootstrap step.
" Update it with :PlugUpgrade and commit the diff.
"
" The plugin directory must NOT be inside 'runtimepath' - vim-plug manages
" rtp itself, and overlapping the two breaks it.
if filereadable(expand('<sfile>:p:h') . '/autoload/plug.vim')
  call plug#begin(s:data . '/vim/plugged')

  " Editing. surround is declared before sneak so its visual-mode `S` claims
  " that key first; sneak checks mapcheck() and steps aside.
  Plug 'tpope/vim-surround'
  Plug 'tpope/vim-repeat'
  Plug 'tpope/vim-commentary'
  Plug 'justinmk/vim-sneak'
  Plug 'andymass/vim-matchup'
  Plug 'editorconfig/editorconfig-vim'

  " fzf. The binary is already installed by brew, so the local path is added
  " to rtp directly instead of cloning a second copy of the repo.
  if isdirectory('/opt/homebrew/opt/fzf')
    Plug '/opt/homebrew/opt/fzf'
  elseif isdirectory('/home/linuxbrew/.linuxbrew/opt/fzf')
    Plug '/home/linuxbrew/.linuxbrew/opt/fzf'
  else
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
  endif
  Plug 'junegunn/fzf.vim'

  " Git. The shell already has gum-driven wrappers and lazygit; fugitive is
  " here for the things that want to happen inside the buffer - blame, diff,
  " and staging hunks while editing.
  Plug 'tpope/vim-fugitive'

  " Writing.
  Plug 'junegunn/goyo.vim'

  " LSP. Pure vimscript over +job/+channel - this vim is -python3 -lua, so
  " anything with an embedded interpreter is not an option.
  Plug 'prabirshrestha/vim-lsp'
  Plug 'prabirshrestha/asyncomplete.vim'
  Plug 'prabirshrestha/asyncomplete-lsp.vim'
  Plug 'mattn/vim-lsp-settings'

  " plug#end() runs `filetype plugin indent on` and `syntax enable`.
  call plug#end()
else
  " No plug.vim - still a usable editor, just without any of the above.
  filetype plugin indent on
  syntax enable
endif

" --- Behaviour --------------------------------------------------------------
set encoding=utf-8
scriptencoding utf-8
set hidden
set autoread
set confirm
set backspace=indent,eol,start
set nostartofline
set splitbelow splitright
set history=1000
set updatetime=300
set timeoutlen=500
" Without a short ttimeoutlen, leaving insert mode lags a full second - the
" same reason the shell runs `bindkey -v` with a fast KEYTIMEOUT.
set ttimeoutlen=10
" The `# vim: filetype=zsh` headers on myscripts/* and functions.zsh depend
" on this. It is on by default, but it is load-bearing here, so it is stated.
set modeline modelines=5
set completeopt=menuone,noinsert,noselect
set shortmess+=c

" --- Search -----------------------------------------------------------------
set ignorecase smartcase
set incsearch hlsearch
if executable('rg')
  let &grepprg = 'rg --vimgrep --smart-case --hidden --glob=!.git/'
  set grepformat=%f:%l:%c:%m
endif

" --- UI ---------------------------------------------------------------------
" retrobox is vim's bundled gruvbox port, so this matches the nvim theme
" without pulling in a colorscheme plugin.
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
  let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
  let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  set termguicolors
endif
set background=dark
silent! colorscheme retrobox

set number relativenumber
" netrw stamps g:netrw_bufsettings onto its listing buffers after drawing them,
" so the window-local settings above get clobbered in the directory browser.
" This is netrw's default string (noma nomod nonu nobl nowrap ro nornu) with
" the two number flags flipped, to match the hybrid numbering everywhere else.
let g:netrw_bufsettings = 'noma nomod nu rnu nobl nowrap ro'
set cursorline
set ruler showcmd
set laststatus=2
set scrolloff=4 sidescrolloff=8
set display+=lastline
set shortmess+=I
set belloff=all
set list listchars=tab:»·,trail:·,nbsp:␣,extends:›,precedes:‹
set wildmenu
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*/.git/*,*/node_modules/*,*/__pycache__/*,*.pyc
" Off by default so a commit message isn't 2 columns narrower for nothing;
" LSP buffers turn it on themselves below.
set signcolumn=no

" --- Indentation ------------------------------------------------------------
" editorconfig-vim reads .editorconfig and overrides these per project; these
" are the defaults for everything outside one.
set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set shiftround
set autoindent
augroup vimrc_indent
  autocmd!
  autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4
  autocmd FileType make   setlocal noexpandtab
augroup END

" Reopen a file where it was left, except for commit messages - those want a
" fresh cursor at the top every time.
augroup vimrc_lastpos
  autocmd!
  autocmd BufReadPost *
        \ if &filetype !~# '^\(git\|gitcommit\|gitrebase\)$'
        \    && line("'\"") >= 1 && line("'\"") <= line("$") |
        \   execute "normal! g`\"" |
        \ endif
augroup END

" --- Keymaps ----------------------------------------------------------------
nnoremap <Space> <Nop>

" <C-l> already redraws; clearing the search highlight on the way is free.
nnoremap <silent> <C-l> :nohlsearch<CR><C-l>

nnoremap <leader>w :write<CR>
nnoremap Y y$
nnoremap n nzzzv
nnoremap N Nzzzv
xnoremap < <gv
xnoremap > >gv
" Explicit clipboard yanks - 'clipboard=unnamed' would mean every delete in a
" commit message clobbers whatever was in the pasteboard.
nnoremap <leader>y "+y
xnoremap <leader>y "+y
nnoremap <leader>Y "+y$

" Conflict markers. This vim has no built-in `]n` motion (that one is a
" neovim/unimpaired thing), and `git rebase` conflict edits are a main reason
" this config exists.
nnoremap <silent> ]x /^\(<\{7\}\\|=\{7\}\\|>\{7\}\)/<CR>
nnoremap <silent> [x ?^\(<\{7\}\\|=\{7\}\\|>\{7\}\)?<CR>

" Mouse stays off so terminal select-and-copy keeps working, matching the
" disable_mouse setting in the nvim hardtime config. Uncomment to enable:
" set mouse=a

" Plugin mappings are defined unconditionally on purpose. Guarding them with
" exists(':Files') does not work: vim sources plugin/ files only after the
" vimrc has finished, so at this point no plugin command exists yet and every
" mapping would be silently skipped. Worst case without the plugin installed
" is E492 on keypress, which says exactly what is wrong.

" fzf.vim
nnoremap <leader>f :Files<CR>
nnoremap <leader>F :GFiles<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>r :Rg<CR>
nnoremap <leader>/ :BLines<CR>
nnoremap <leader>: :History:<CR>

" fugitive
nnoremap <leader>gs :Git<CR>
nnoremap <leader>gb :Git blame<CR>
nnoremap <leader>gd :Gdiffsplit<CR>
nnoremap <leader>gl :Git log --oneline --decorate --graph<CR>

" goyo
nnoremap <leader>z :Goyo<CR>

" --- LSP --------------------------------------------------------------------
" Mappings are buffer-local, applied only once a server actually attaches, so
" `K` stays keywordprg and `gd` stays goto-local-definition everywhere else -
" including in a commit message, where no server ever attaches.
function! s:on_lsp_buffer_enabled() abort
  setlocal omnifunc=lsp#complete
  setlocal signcolumn=yes
  nmap <buffer> gd <plug>(lsp-definition)
  nmap <buffer> gr <plug>(lsp-references)
  nmap <buffer> gi <plug>(lsp-implementation)
  nmap <buffer> gt <plug>(lsp-type-definition)
  nmap <buffer> K  <plug>(lsp-hover)
  " Grouped under <leader>c, not <leader>rn: <leader>r is :Rg, and vim waits
  " out 'timeoutlen' on any mapping that is a strict prefix of another.
  nmap <buffer> <leader>cr <plug>(lsp-rename)
  nmap <buffer> <leader>ca <plug>(lsp-code-action)
  nmap <buffer> <leader>cf <plug>(lsp-document-format)
  nmap <buffer> [d <plug>(lsp-previous-diagnostic)
  nmap <buffer> ]d <plug>(lsp-next-diagnostic)
endfunction

augroup vimrc_lsp
  autocmd!
  autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
augroup END

" Completion popup: <Tab> walks it, <CR> accepts it. All three fall through to
" their normal meaning when no popup is open, so <CR> still just breaks a line
" while writing a commit message.
"
" These are plain built-in keys rather than asyncomplete#close_popup(), which
" would need an exists('*...') guard that can never be true here - autoload
" functions are not defined until something first calls them. <C-y> accepts
" the selected match and works with or without the plugin installed.
inoremap <expr> <Tab>   pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
inoremap <expr> <CR>    pumvisible() ? "\<C-y>" : "\<CR>"
