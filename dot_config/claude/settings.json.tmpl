{{- /* the company machine has the 1M-context Opus entitlement; personal doesn't */ -}}
{{- $model :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "default" "opus"
        "table" (dict
          "darwin/A0229/jack.cho" "opus[1m]"
          "darwin/jack06215/nacho" "opus"
        )
      )
-}}
{{- /* read scope outside the cwd; empty on machines without that checkout */ -}}
{{- $monorepo :=
      includeTemplate "lookup" (dict
        "chezmoi" .chezmoi
        "table" (dict
          "darwin/jack06215/nacho" (joinPath .chezmoi.homeDir "workspace/jack06215/monorepo")
        )
      )
-}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "preferredNotifChannel": "terminal_bell",
  "statusLine": {
    "type": "command",
    "command": "${XDG_CONFIG_HOME}/claude/statusline_command.sh",
    "padding": 2
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "${XDG_CONFIG_HOME}/claude/statusline_command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "editorMode": "vim",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh api *annotations*)",
      "Bash(gh api *commits*)",
      "Bash(gh api *comments*)",
      "Bash(gh api *reviews*)",
      "Bash(gh api *status*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git log:*)",
      "Bash(git --no-pager log:*)",
      "Bash(git show:*)",
      "Bash(git --no-pager show:*)",
      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(sed -n '/*/p':*)",
      "Bash(sed -n '/*/{=;p}':*)",
      "Bash(bazel run //tools/*)",
      "Bash(bazel test:*)",
      "Bash(npx markdownlint-cli:*)",
      "Bash(NO_UPDATE_NOTIFIER=1 npx markdownlint-cli:*)",
      "Bash(python -m pytest:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(poetry run ruff:*)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)"
    ],
{{- if $monorepo }}
    "additionalDirectories": [{{ $monorepo | quote }}],
{{- end }}
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "bazel",
      "chezmoi",
      "docker",
      "gh",
      "git"
    ],
    "network": {
      "allowLocalBinding": true
    }
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "TASK_MAX_OUTPUT_LENGTH": "80000"
  },
  "attribution": {
    "sessionUrl": false
  },
  "teammateMode": "auto",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "model": {{ $model | quote }},
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "theme": "dark",
  "effortLevel": "xhigh"
}
