// Keys for everywhere nvim cannot hear: the explorer, lists, pickers, the
// terminal, and the few editor keys vscode-neovim leaves to VS Code.
//
// In the editor, vscode-neovim hands keys to nvim, and the leader maps live in
// ~/.config/nvim/lua/config/keymaps/vscode.lua. So nothing here may start a
// chord with `space` while the editor has focus: VS Code would swallow the
// space waiting for the rest of the chord, and nvim would never see <leader>.
//
// neovim.mode (normal / insert / visual / cmdline / replace) and neovim.init
// are vscode-neovim's context keys.
[
  // ---------------------------------------------------------------- panes ----
  // LazyVim's <C-h/j/k/l>. In the editor nvim already handles them (LazyVim
  // remaps them onto vscode-neovim's <C-w>h...); these cover the sidebar,
  // panels, the terminal and non-text editors. The terminal matches LazyVim's
  // snacks terminal split, whose term_nav moves windows too, so the shell
  // never sees ^H ^J ^K ^L; the navigate commands are on VS Code's default
  // terminal.integrated.commandsToSkipShell, so no entry is needed there.
  // Not in a picker (quick open, or nvicode's TUI pickers and neogit), where
  // Ctrl-j/k move the selection. Outside macOS, Ctrl-k stays VS Code's chord
  // prefix (Ctrl-k Ctrl-s and friends) except in the terminal, which would
  // otherwise have no way back up to the editor.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "!editorTextFocus && !inQuickOpen && !nvicode.activeTerminalIsTui"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "!editorTextFocus && !inQuickOpen && !nvicode.activeTerminalIsTui"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "isMac && !editorTextFocus && !inQuickOpen && !nvicode.activeTerminalIsTui"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "!isMac && terminalFocus && !nvicode.activeTerminalIsTui"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "!editorTextFocus && !inQuickOpen && !nvicode.activeTerminalIsTui"
  },

  // -------------------------------------------------------- leader outside the editor ----
  // Space in a list (explorer, source control, search results, problems...)
  // opens nvicode's which-key, with nvim's own leader keys, Harpoon's included.
  // No `space …` chord may live here: VS Code would take the space waiting
  // for the rest of it, and nvicode's single-key binding would never fire.

  // ---------------------------------------------------------------- lists ----
  // Moving around trees and lists the way nvim buffers do (neo-tree, trouble,
  // neogit, the quickfix window).
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "listFocus && !inputFocus && !inQuickOpen && !filesExplorerFocus"
  },
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "listFocus && !inputFocus && !inQuickOpen"
  },
  {
    "key": "/",
    "command": "list.find",
    "when": "listFocus && listSupportsFind && !inputFocus && !inQuickOpen"
  },
  {
    "key": "q",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.closeSidebar", "workbench.action.focusActiveEditorGroup"]
    },
    "when": "listFocus && sideBarFocus && !inputFocus"
  },
  {
    "key": "q",
    "command": "workbench.action.closePanel",
    "when": "listFocus && panelFocus && !inputFocus"
  },

  // ------------------------------------------------------------- explorer ----
  // neo-tree's keys (window.mappings in plugins/nvim-neo-tree, plus the
  // LazyVim neo-tree extra's l/h/Y/O/P).
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "l",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "filesExplorerFocus && foldersViewVisible && explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "backspace",
    "command": "list.focusParent",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "shift+c",
    "command": "list.collapse",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "z",
    "command": "workbench.files.action.collapseExplorerFolders",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "shift+r",
    "command": "workbench.files.action.refreshFilesExplorer",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  // To the trash, not moveFileToTrash's permanent sibling deleteFile: with
  // explorer.confirmDelete off there is no prompt to catch a stray `d`.
  {
    "key": "d",
    "command": "moveFileToTrash",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // m (move) and b (rename basename) too: VS Code's rename box takes a path
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "m",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "b",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus"
  },
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  // plugins/nvim-neo-tree's copy_path_to_clipboard: the absolute path
  {
    "key": "shift+y",
    "command": "copyFilePath",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "shift+s",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors"
      ]
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "shift+p",
    "command": "filesExplorer.openFilePreserveFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "shift+o",
    "command": "revealFileInOS",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },

  // -------------------------------------------------------------- pickers ----
  // snacks' picker moves with Ctrl-j/k as well; vscode-neovim already gives
  // quick open Ctrl-n/p.
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen && neovim.mode != cmdline"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen && neovim.mode != cmdline"
  },

  // ----------------------------------------------------------- completion ----
  // blink.cmp with LazyVim's "enter" preset: Enter or Ctrl-y accepts, Ctrl-n/p
  // (vscode-neovim) or the arrows move, Ctrl-e closes, and Tab is left to
  // snippet jumps and Copilot instead of accepting the menu.
  {
    "key": "tab",
    "command": "-acceptSelectedSuggestion",
    "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+y",
    "command": "acceptSelectedSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+e",
    "command": "hideSuggestWidget",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  // LazyVim's insert-mode <c-k>. macOS only: elsewhere Ctrl-k is the chord prefix.
  {
    "key": "ctrl+k",
    "command": "editor.action.triggerParameterHints",
    "when": "isMac && editorTextFocus && neovim.mode == 'insert'"
  },

  // ----------------------------------------------- editor keys nvim never gets ----
  // vscode-neovim leaves Alt and Ctrl-s to VS Code, so LazyVim's <A-j>/<A-k>
  // (move lines, any mode) and <C-s> (save; leaves insert mode) live here.
  {
    "key": "alt+j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+s",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.action.files.save", "vscode-neovim.escape"]
    },
    "when": "editorTextFocus && neovim.mode == 'insert'"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save",
    "when": "editorTextFocus && neovim.mode != 'insert'"
  },

  // ------------------------------------------------------------- terminal ----
  // <c-/> toggles it from inside as well as from the editor (nvim maps that).
  // Not in nvicode's TUIs, where ctrl+/ is the pickers' key help.
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminalFocus && !nvicode.activeTerminalIsTui"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "ctrl+shift+b",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+a",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+n",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+q",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  }
]
